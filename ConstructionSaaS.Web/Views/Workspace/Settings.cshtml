@model ConstructionSaaS.Web.Models.AdminWorkspaceViewModel
@{ Layout = ViewData["IsManager"] is true ? "_ManagerModuleLayout" : "_AdminWorkspaceLayout"; ViewData["Title"] = ViewData["IsManager"] is true ? "Profile & security" : "Settings"; ViewData["Active"] = "Settings"; }
@section Styles { <link rel="stylesheet" href="~/css/account-profile.css" asp-append-version="true" /> }
<div class="account-profile">
<section class="module-hero"><div><p class="eyebrow">ACCOUNT &amp; SECURITY</p><h1>Your profile & security.</h1><p>Manage account details and keep access to your company secure.</p></div></section>
<section class="panel account-identity"><div class="module-heading"><div class="account-person"><span class="account-monogram" aria-hidden="true">@(string.IsNullOrWhiteSpace(Model.Account.Email) ? "U" : Model.Account.Email[..1].ToUpperInvariant())</span><div><p class="eyebrow">YOUR ACCOUNT</p><h2>@Model.Account.Email</h2><span class="account-role">@Model.Account.Role.Replace("CompanyAdmin", "Company admin").Replace("ProjectManager", "Project manager").Replace("SiteEngineer", "Site engineer")</span></div></div>@if (ViewData["IsManager"] is not true) { <a class="module-secondary" asp-controller="CompanyProfile" asp-action="Index">Company profile</a> }</div></section>
<div class="module-columns account-forms"><section class="panel"><h2>Change email</h2><p class="module-muted">Use an address you control. You will sign in again with your new address after saving.</p><form asp-action="ChangeEmail" method="post" class="module-form">@Html.AntiForgeryToken()<label>Email address<input name="Email" type="email" autocomplete="email" required maxlength="256" value="@Model.Account.Email" /></label><label>Current password<input name="CurrentPassword" type="password" autocomplete="current-password" required /></label><button type="submit" class="primary-button">Update email</button></form></section>
<section class="panel"><h2>Change password</h2><p class="module-muted">Use at least 8 characters with uppercase, lowercase, a number and a symbol. Changing your password signs out existing sessions.</p><form asp-action="ChangePassword" method="post" class="module-form">@Html.AntiForgeryToken()<label>Current password<input name="CurrentPassword" type="password" autocomplete="current-password" required /></label><label>New password<input name="NewPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128" required /></label><label>Confirm new password<input name="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128" required /></label><button type="submit" class="primary-button">Update password</button></form></section></div>
<section class="panel account-sessions"><h2>Account sessions</h2><p class="module-muted">Control access to your account across browsers and devices.</p><div class="module-actions"><form asp-action="SignOutAll" method="post" onsubmit="return confirm('Sign out all sessions, including this one?');">@Html.AntiForgeryToken()<button type="submit" class="module-danger">Sign out all sessions</button></form>@if (ViewData["IsManager"] is not true) { <a class="module-secondary" asp-controller="TeamMembers" asp-action="Index">Manage team access</a> }<form asp-controller="Account" asp-action="Logout" method="post">@Html.AntiForgeryToken()<button type="submit" class="module-secondary">Sign out this browser</button></form></div></section>


</div>
