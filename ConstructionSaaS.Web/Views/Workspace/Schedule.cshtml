@model ConstructionSaaS.Web.Models.AdminWorkspaceViewModel
@{ Layout = ViewData["IsManager"] is true ? "_ManagerModuleLayout" : "_AdminWorkspaceLayout"; ViewData["Title"] = "Schedule & milestones"; ViewData["Active"] = "Schedule"; }
<section class="module-hero"><div><p class="eyebrow">PLAN. TRACK. DELIVER.</p><h1>Schedule & milestones.</h1><p>Keep every delivery on track.</p></div><a class="primary-button" asp-controller="@(ViewData["IsManager"] is true ? "ManagerProjects" : "Projects")" asp-action="Index">Manage projects &rarr;</a></section>
@if (Model.Report.Projects.Count == 0) { <section class="panel module-empty"><h2>Your schedule starts with a project</h2><p>@(ViewData["IsManager"] is true ? "Your company admin can assign a project to get you started." : "Create a project and add its first milestone.")</p>@if (ViewData["IsManager"] is not true) { <a class="primary-button" asp-controller="Projects" asp-action="Create">Create project</a> }</section> }
else {
<partial name="_WorkspaceProjectPicker" model="Model" />
var project = Model.SelectedProject!;
<section class="module-metrics"><article><span>Planned start</span><strong>@(project.Start?.ToString("dd MMM yyyy") ?? "Not set")</strong></article><article><span>Delivery date</span><strong>@(project.End?.ToString("dd MMM yyyy") ?? "Not set")</strong><small>@(project.IsOverdue ? "Overdue" : project.Status)</small></article><article><span>Milestone progress</span><strong>@(project.Progress.HasValue ? $"{project.Progress}%" : "Not tracked")</strong><small>Equal weight per milestone</small></article><article><span>Completed milestones</span><strong>@project.CompletedMilestones / @project.Milestones</strong><small>@project.OverdueMilestones overdue</small></article></section>
<div class="module-heading"><h2>@project.Name</h2><a class="text-link" asp-controller="@(ViewData["IsManager"] is true ? "ManagerProjects" : "Projects")" asp-action="@(ViewData["IsManager"] is true ? "Details" : "Edit")" asp-route-id="@project.Id">@(ViewData["IsManager"] is true ? "Project details" : "Edit project dates") &rarr;</a></div>
<div class="schedule-columns">
<section class="panel"><div class="module-heading"><h2>Milestones</h2><span class="module-pill">@Model.Milestones.Count total</span></div>
@if (Model.Milestones.Count == 0) { <p class="module-empty">No milestones yet. Use the Add a milestone form to create your first delivery checkpoint.</p> }
@foreach (var m in Model.Milestones) {
<article class="milestone-row"><div class="milestone-summary"><span class="milestone-date"><strong>@m.DueDateUtc.ToString("dd")</strong>@m.DueDateUtc.ToString("MMM")</span><div><h3>@m.Title</h3><p>Due @m.DueDateUtc.ToString("dd MMM yyyy") <span class="module-pill @(m.IsOverdue && project.Status != "Completed" && project.Status != "Cancelled" ? "danger" : "")">@(m.Progress == 100 ? "Completed" : m.IsOverdue && project.Status != "Completed" && project.Status != "Cancelled" ? "Overdue" : m.Progress == 0 ? "Not started" : "In progress")</span></p>@if (!string.IsNullOrWhiteSpace(m.Notes)) { <p>@m.Notes</p> }</div><div class="milestone-progress"><strong>@m.Progress%</strong><progress max="100" value="@m.Progress" aria-label="@($"{m.Title}: {m.Progress}%")"></progress></div></div>
<details class="milestone-edit"><summary>Edit milestone</summary><form asp-action="SaveMilestone" method="post" class="module-form">@Html.AntiForgeryToken()<input type="hidden" name="projectId" value="@project.Id" /><input type="hidden" name="id" value="@m.Id" /><div class="form-grid"><label>Title<input name="Title" value="@m.Title" required maxlength="160" /></label><label>Due date<input type="date" name="DueDateUtc" value="@m.DueDateUtc.ToString("yyyy-MM-dd")" min="2000-01-01" max="2100-12-31" required /></label><label>Progress (%)<input name="Progress" type="number" min="0" max="100" value="@m.Progress" required /></label></div><label>Notes<textarea name="Notes" maxlength="2000" rows="2">@m.Notes</textarea></label><button class="primary-button" type="submit">Save changes</button></form><form asp-action="DeleteMilestone" method="post" onsubmit="return confirm('Remove this milestone?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@m.Id" /><input type="hidden" name="projectId" value="@project.Id" /><button class="module-danger" type="submit">Remove milestone</button></form></details></article>
}
</section>
<section class="panel schedule-create" id="add-milestone"><h2>Add a milestone</h2><form asp-action="SaveMilestone" method="post" class="module-form">@Html.AntiForgeryToken()<input type="hidden" name="projectId" value="@project.Id" /><div class="form-grid"><label>Milestone title<input name="Title" required maxlength="160" placeholder="e.g. Foundation inspection" /></label><label>Due date (UTC)<input type="date" name="DueDateUtc" required min="2000-01-01" max="2100-12-31" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" /></label><label>Progress (%)<input name="Progress" type="number" min="0" max="100" required value="0" /></label></div><label>Notes<textarea name="Notes" maxlength="2000" rows="2" placeholder="Acceptance criteria or delivery notes"></textarea></label><button class="primary-button" type="submit">Add milestone</button></form></section>
</div>
<section class="panel"><h2>Portfolio deadlines</h2><div class="module-table-wrap"><table><thead><tr><th>Project</th><th>Start</th><th>Delivery</th><th>Status</th></tr></thead><tbody>@foreach (var p in Model.Report.Projects.OrderBy(p => p.End ?? DateTime.MaxValue)) { <tr><td><a asp-action="Schedule" asp-route-projectId="@p.Id">@p.Name</a></td><td>@(p.Start?.ToString("dd MMM yyyy") ?? "Not set")</td><td>@(p.End?.ToString("dd MMM yyyy") ?? "Not set")</td><td><span class="module-pill @(p.IsOverdue ? "danger" : "")">@(p.IsOverdue ? "Overdue" : p.Status)</span></td></tr> }</tbody></table></div></section>
}

