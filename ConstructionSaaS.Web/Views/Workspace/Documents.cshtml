@model ConstructionSaaS.Web.Models.AdminWorkspaceViewModel
@{ Layout = ViewData["IsManager"] is true ? "_ManagerModuleLayout" : "_AdminWorkspaceLayout"; ViewData["Title"] = "Documents"; ViewData["Active"] = "Documents"; }
<section class="module-hero"><div><p class="eyebrow">PROJECT KNOWLEDGE</p><h1>Project documents</h1><p>Keep drawings, contracts and records organized by project.</p></div></section>
@if (Model.Report.Projects.Count == 0) { <section class="panel module-empty"><h2>A project is needed first</h2><p>Documents are always attached to a project.</p>@if (ViewData["IsManager"] is not true) { <a class="primary-button" asp-controller="Projects" asp-action="Create">Create project</a> } else { <p>Ask your company admin to assign a project.</p> }</section> }
else {
<partial name="_WorkspaceProjectPicker" model="Model" />
<section class="panel document-upload"><h2>Upload to @Model.SelectedProject!.Name</h2><p class="module-muted">PDF, PNG, JPG, UTF-8 TXT or CSV. Maximum 10 MB per file and 100 MB per company.</p><form asp-action="Upload" method="post" enctype="multipart/form-data" class="module-form">@Html.AntiForgeryToken()<input type="hidden" name="projectId" value="@Model.ProjectId" /><label class="upload-zone"><i class="fa-solid fa-cloud-arrow-up" aria-hidden="true"></i><span>Choose a project document</span><input type="file" name="file" accept=".pdf,.png,.jpg,.jpeg,.txt,.csv" required /></label><button class="primary-button" type="submit">Upload document</button></form></section>
<section class="panel document-library"><div class="module-heading"><h2>Project files</h2><span class="module-pill">@Model.Documents.Count documents</span></div>
@if (ViewData["IsManager"] is true) { <p class="module-muted">You can upload and download project files. Only your own uploads can be removed. Files with no verified uploader can only be removed by your company admin.</p> }

@if (Model.Documents.Count == 0) { <div class="module-empty"><i class="fa-regular fa-folder-open" aria-hidden="true"></i><h3>No documents yet</h3><p>Upload the first file for this project.</p></div> }
else { <div class="module-table-wrap" tabindex="0" role="region" aria-label="Project documents"><table><thead><tr><th>Document</th><th>Size</th><th>Uploaded by</th><th>Added (UTC)</th><th>Actions</th></tr></thead><tbody>@foreach (var d in Model.Documents) { <tr><td><span class="document-file-icon" aria-hidden="true"><i class="fa-regular fa-file-lines"></i></span><strong>@d.FileName</strong></td><td>@((d.Size / 1024d).ToString("N1")) KB</td><td>@d.UploadedBy</td><td>@d.UploadedAtUtc.ToString("dd MMM yyyy, HH:mm")</td><td><div class="module-actions"><a class="module-secondary" asp-action="Download" asp-route-id="@d.Id">Download</a>@if (d.CanDelete) { <form asp-action="DeleteDocument" method="post" onsubmit="return confirm('Permanently remove this document?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@d.Id" /><input type="hidden" name="projectId" value="@Model.ProjectId" /><button class="module-danger" type="submit">Remove</button></form> } else { <span class="module-pill" title="Only the uploader or company admin can remove this file.">Protected file</span> }</div></td></tr> }</tbody></table></div> }
</section>
}

