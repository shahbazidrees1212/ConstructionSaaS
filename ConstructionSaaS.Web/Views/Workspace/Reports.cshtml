@model ConstructionSaaS.Web.Models.AdminWorkspaceViewModel
@{ Layout = ViewData["IsManager"] is true ? "_ManagerModuleLayout" : "_AdminWorkspaceLayout"; ViewData["Title"] = "Reports"; ViewData["Active"] = "Reports"; var projects = Model.Report.Projects; }
<section class="module-hero"><div><p class="eyebrow">OPERATIONS INSIGHTS</p><h1>Project reports</h1><p>Project delivery, milestone progress and team capacity in one view.</p></div><a class="primary-button" asp-action="ExportReport"><i class="fa-solid fa-download" aria-hidden="true"></i> Export CSV</a></section>
<section class="module-metrics"><article><span>Projects</span><strong>@projects.Count</strong><small>@projects.Count(p => p.Status == "Active") active</small></article><article><span>Delivered</span><strong>@projects.Count(p => p.Status == "Completed")</strong><small>Completed projects</small></article><article><span>Overdue projects</span><strong>@projects.Count(p => p.IsOverdue)</strong><small>@projects.Sum(p => p.OverdueMilestones) overdue milestones</small></article><article><span>Active team</span><strong>@Model.Report.ActiveMembers</strong><small>@Model.Report.InactiveMembers inactive</small></article></section>
<div class="module-columns report-insights"><section class="panel"><h2>Budgets by currency</h2><p class="module-muted">Different currencies are reported separately. No exchange-rate conversion is applied.</p>@if (!projects.Any(p => p.Budget.HasValue)) { <p class="module-empty">No budgets entered yet.</p> }@foreach (var group in projects.Where(p => p.Budget.HasValue).GroupBy(p => p.Currency)) { <div class="budget-row"><strong>@group.Key</strong><span>@group.Sum(p => p.Budget ?? 0).ToString("N2")</span></div> }</section><section class="panel"><h2>Project status</h2>@foreach (var group in projects.GroupBy(p => p.Status)) { <div class="report-status-row"><div class="budget-row"><span>@group.Key</span><strong>@group.Count()</strong></div><progress max="@projects.Count" value="@group.Count()" aria-label="@($"{group.Key}: {group.Count()} of {projects.Count} projects")"></progress></div> }@if (projects.Count == 0) { <p class="module-empty">Your assigned portfolio will appear here when projects are available.</p> }</section></div>
<section class="panel"><div class="module-heading"><h2>Delivery report</h2><span class="module-muted">Progress = average milestone completion</span></div><div class="module-table-wrap delivery-report" tabindex="0" role="region" aria-label="Project delivery report"><table><thead><tr><th>Project</th><th>Status</th><th>Progress</th><th>Milestones</th><th>Delivery</th><th>Team</th><th>Files</th></tr></thead><tbody>@foreach (var p in projects) { <tr><td><a asp-action="Schedule" asp-route-projectId="@p.Id"><strong>@p.Name</strong></a><small>@p.Code</small></td><td><span class="module-pill @(p.IsOverdue ? "danger" : "")">@(p.IsOverdue ? "Overdue" : p.Status)</span></td><td>@(p.Progress.HasValue ? $"{p.Progress}%" : "Not tracked")@if(p.Progress.HasValue){<progress class="report-progress" value="@p.Progress" max="100" aria-label="@($"{p.Name}: {p.Progress}% complete")"></progress>}</td><td>@p.CompletedMilestones / @p.Milestones</td><td>@(p.End?.ToString("dd MMM yyyy") ?? "Not set")</td><td>@p.Assignments</td><td><a asp-action="Documents" asp-route-projectId="@p.Id">@p.Documents documents</a></td></tr> }@if (projects.Count == 0) { <tr><td colspan="7" class="module-empty">No project data to report.</td></tr> }</tbody></table></div></section>

