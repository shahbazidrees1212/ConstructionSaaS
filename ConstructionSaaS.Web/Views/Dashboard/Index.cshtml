@model ConstructionSaaS.Web.Models.DashboardViewModel
@{
    Layout = null;
    ViewData["Active"] = "Dashboard";
    ViewData["Title"] = "Dashboard";
    var featured = Model.Projects.FirstOrDefault();
    var reports = Model.WorkspaceReport?.Projects;
    var featuredReport = reports?.FirstOrDefault(p => p.Id == featured?.Id);
    var initial = string.IsNullOrWhiteSpace(Model.AccountEmail) ? "CA" : Model.AccountEmail[..1].ToUpperInvariant();
    var projectError = ViewBag.ProjectsError as string ?? ViewBag.ErrorMessage as string;
}
<!DOCTYPE html><html lang="en"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Dashboard | ConstructionSaaS</title>
<link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/css/workspace-polish.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/css/clarity-dashboard.css" asp-append-version="true"/>
</head><body class="clarity-dashboard"><a class="skip-link" href="#workspaceContent">Skip to content</a>
<div class="dashboard"><partial name="_AdminSidebar"/><main class="main">
<header class="clarity-topbar"><div>Workspace <span>/</span> <strong>Dashboard</strong></div><div class="clarity-tools"><label class="clarity-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input id="projectSearch" type="search" placeholder="Search your projects…" aria-label="Search projects" aria-controls="projectRows"/></label><details id="accountMenu"><summary aria-label="Account menu"><span class="clarity-avatar">@initial</span></summary><div class="clarity-account"><strong>Company admin</strong><small>@Model.AccountEmail</small><a asp-controller="Workspace" asp-action="Settings">Profile &amp; security</a><form asp-controller="Account" asp-action="Logout" method="post"><button type="submit">Sign out</button></form></div></details></div></header>
<div class="clarity-content" id="workspaceContent">
<div class="clarity-heading"><div><h1>Build with clarity.</h1><p>Your workspace, at a glance.</p></div><div class="clarity-heading-actions"><time datetime="@DateTime.UtcNow.ToString("yyyy-MM-dd")"><i class="fa-regular fa-calendar" aria-hidden="true"></i> @DateTime.UtcNow.ToString("dd MMM yyyy")</time><a class="clarity-button" asp-controller="Projects" asp-action="Create"><span aria-hidden="true">+</span> New project</a></div></div>
@if (!string.IsNullOrWhiteSpace(projectError)){<p class="clarity-notice" role="alert">@projectError</p>}
@if (!string.IsNullOrWhiteSpace(Model.WorkspaceError)){<p class="clarity-notice" role="status">@Model.WorkspaceError</p>}
@if (!Model.TeamMembersLoaded){<p class="clarity-notice" role="status">Team information is currently unavailable.</p>}
<div class="clarity-grid">
<section class="clarity-feature"><video class="clarity-feature-video" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"><source data-src="/videos/construction-site-live.mp4" type="video/mp4" /></video><button class="clarity-video-toggle" type="button" hidden aria-label="Pause background video">Pause motion</button><div class="clarity-feature-copy"><p class="clarity-label">FEATURED PROJECT</p><h2>@(featured?.Name ?? "Your next build starts here.")</h2>
@if(featured != null){<span class="clarity-status">@featured.Status</span><div class="clarity-progress"><strong>@(featuredReport?.Progress is int progress ? $"{progress}%" : "Not tracked")</strong>@if(featuredReport?.Progress is int value){<progress value="@value" max="100" aria-label="Featured project progress">@value%</progress>}</div><a class="clarity-feature-link" asp-controller="Projects" asp-action="Edit" asp-route-id="@featured.Id">View project <span aria-hidden="true">&#8594;</span></a>}
else{<p>Create a project to organize your team, milestones and documents.</p><a class="clarity-feature-link" asp-controller="Projects" asp-action="Create">Create a project &#8594;</a>}
</div><span class="clarity-image-caption">Construction footage</span></section>
<section class="clarity-panel clarity-pulse"><h2>Workspace pulse</h2><dl><div><dd>@(projectError == null ? Model.TotalProjects.ToString() : "—")</dd><dt>Projects</dt></div><div><dd>@(projectError == null ? Model.ActiveProjects.ToString() : "—")</dd><dt>Active</dt></div><div><dd>@(Model.TeamMembersLoaded ? Model.TotalTeamMembers.ToString() : "—")</dd><dt>Team members</dt></div><div><dd>@(reports?.Sum(p=>p.Documents).ToString() ?? "—")</dd><dt>Documents</dt></div></dl><a asp-controller="Workspace" asp-action="Schedule">@(reports != null ? $"{reports.Sum(p=>p.CompletedMilestones)} of {reports.Sum(p=>p.Milestones)} milestones delivered" : "Milestone summary unavailable") <span aria-hidden="true">&#8594;</span></a></section>
<section class="clarity-panel clarity-projects"><div class="clarity-section-heading"><h2>Projects</h2><a asp-controller="Projects" asp-action="Index">View all &#8594;</a></div><div class="clarity-filter"><label for="projectStatus">Status</label><select id="projectStatus"><option value="">All statuses</option>@foreach(var status in Model.Projects.Select(p=>p.Status).Distinct()){<option value="@status">@status</option>}</select><button id="resetFilters" type="button">Reset</button><span id="filterResult" aria-live="polite">@Model.Projects.Count projects shown</span></div><div class="clarity-table"><table><thead><tr><th>Project</th><th>Status</th><th>Progress</th><th>Team</th></tr></thead><tbody id="projectRows">
@foreach(var project in Model.Projects){var report=reports?.FirstOrDefault(p=>p.Id==project.Id);<tr class="project-data-row" data-search="@project.Name @project.Id" data-status="@project.Status"><td><a asp-controller="Projects" asp-action="Edit" asp-route-id="@project.Id"><span class="clarity-project-icon" aria-hidden="true"><i class="fa-regular fa-building"></i></span>@project.Name</a></td><td><span class="clarity-status">@project.Status</span></td><td>@if(report?.Progress is int amount){<strong>@amount%</strong><progress value="@amount" max="100" aria-label="Progress for @project.Name">@amount%</progress>}else{<span class="clarity-untracked">Not tracked</span>}</td><td><a class="clarity-team-link" asp-controller="ProjectAssignments" asp-action="Index" asp-route-projectId="@project.Id" aria-label="Manage team for @project.Name"><i class="fa-solid fa-users" aria-hidden="true"></i> <span aria-hidden="true">&#8594;</span></a></td></tr>}
<tr id="searchEmptyRow" hidden><td colspan="4">No projects match your search.</td></tr>
@if(Model.Projects.Count==0){<tr><td colspan="4">@(projectError == null ? "No projects yet. Create your first project to get started." : "Project data could not be loaded.")</td></tr>}
</tbody></table></div></section>
<section class="clarity-panel clarity-delivery"><h2>Delivery overview</h2><a asp-controller="Workspace" asp-action="Schedule"><span class="clarity-dot"></span><div><strong>@(reports?.Sum(p=>p.OverdueMilestones).ToString() ?? "—") overdue milestones</strong><small>Review dates and progress</small></div><span aria-hidden="true">&#8594;</span></a><a asp-controller="Projects" asp-action="Index"><span class="clarity-dot outlined"></span><div><strong>@Model.CompletedProjects completed projects</strong><small>Explore your project portfolio</small></div><span aria-hidden="true">&#8594;</span></a><p>Based on your current project records</p></section>
<section class="clarity-panel clarity-activity"><div class="clarity-section-heading"><h2>Recent activity</h2><a asp-controller="Workspace" asp-action="Activity">View history &#8594;</a></div>@foreach(var activity in Model.RecentActivity.Take(3)){<article><span class="clarity-project-icon" aria-hidden="true"><i class="fa-regular fa-file-lines"></i></span><div><strong>@activity.Description</strong><small>@activity.Actor</small></div><time>@activity.OccurredAtUtc.ToString("dd MMM yyyy")</time></article>}@if(Model.RecentActivity.Count==0){<p class="clarity-empty">Your latest workspace updates will appear here.</p>}</section>
<section class="clarity-quick"><h2>Quick actions</h2><a asp-controller="Workspace" asp-action="Documents"><i class="fa-solid fa-arrow-up-from-bracket" aria-hidden="true"></i> Upload document <span aria-hidden="true">&#8594;</span></a><a asp-controller="ProjectAssignments" asp-action="Index"><i class="fa-solid fa-user-plus" aria-hidden="true"></i> Assign team <span aria-hidden="true">&#8594;</span></a></section>
</div><footer class="clarity-footer">&copy; @DateTime.UtcNow.Year ConstructionSaaS <span>Plan. Build. Deliver.</span></footer>
</div></main></div><script src="~/js/dashboard-motion.js" asp-append-version="true" defer></script><script src="~/js/admin-dashboard.js" asp-append-version="true"></script><script src="~/js/workspace-ui.js" asp-append-version="true" defer></script></body></html>
