@model ConstructionSaaS.Application.DTOs.Billing.InvoiceDto
<div class="module-table-wrap"><table class="invoice-items"><thead><tr><th>Description</th><th>Quantity</th><th>Unit price</th><th>Amount</th></tr></thead><tbody>@foreach(var line in Model.Lines) { <tr><td data-label="Description">@line.Description</td><td data-label="Quantity">@line.Quantity</td><td data-label="Unit price">@line.UnitPrice.ToString("N2")</td><td data-label="Amount">@((line.Quantity * line.UnitPrice).ToString("N2"))</td></tr> }</tbody><tfoot><tr><th colspan="3">Total (@Model.Currency)</th><td><strong>@Model.Total.ToString("N2")</strong></td></tr></tfoot></table></div>
