<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] | ConstructionSaaS</title><link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />@await RenderSectionAsync("Styles", required: false)<link rel="stylesheet" href="~/css/workspace-polish.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/workspace-refinement.css" asp-append-version="true" />
</head><body><div class="workspace-shell"><aside class="workspace-sidebar"><a asp-controller="Dashboard" asp-action="Index" class="workspace-brand"><b>C</b><span>Construction<em>SaaS</em></span></a><p class="workspace-label">WORKSPACE</p><nav><a asp-controller="Dashboard" asp-action="Index"><i class="fa-solid fa-house"></i>Dashboard</a><a class="@(ViewData["Active"]?.ToString() == "Projects" ? "active" : "")" asp-controller="Projects" asp-action="Index"><i class="fa-regular fa-folder-open"></i>Projects</a><a class="@(ViewData["Active"]?.ToString() == "Activity" ? "active" : "")" asp-controller="Workspace" asp-action="Activity"><i class="fa-regular fa-clock"></i>Recent Activity</a><a class="@(ViewData["Active"]?.ToString() == "Schedule" ? "active" : "")" asp-controller="Workspace" asp-action="Schedule"><i class="fa-regular fa-calendar"></i>Schedule</a></nav><p class="workspace-label">MANAGEMENT</p><nav><a class="@(ViewData["Active"]?.ToString() == "CompanyProfile" ? "active" : "")" asp-controller="CompanyProfile" asp-action="Index"><i class="fa-regular fa-building"></i>Company Profile</a><a class="@(ViewData["Active"]?.ToString() == "TeamMembers" ? "active" : "")" asp-controller="TeamMembers" asp-action="Index"><i class="fa-solid fa-users"></i>Team Members</a><a asp-controller="ProjectAssignments" asp-action="Index"><i class="fa-solid fa-user-check"></i>Assignments</a><a class="@(ViewData["Active"]?.ToString() == "Documents" ? "active" : "")" asp-controller="Workspace" asp-action="Documents"><i class="fa-regular fa-file-lines"></i>Documents</a><a class="@(ViewData["Active"]?.ToString() == "Reports" ? "active" : "")" asp-controller="Workspace" asp-action="Reports"><i class="fa-solid fa-chart-column"></i>Reports</a><a class="@(ViewData["Active"]?.ToString() == "Settings" ? "active" : "")" asp-controller="Workspace" asp-action="Settings"><i class="fa-solid fa-gear"></i>Settings</a></nav><div class="workspace-sidebar-footer">ConstructionSaaS &middot; Admin workspace</div></aside><div class="workspace-content"><header class="workspace-topbar"><div>Workspace <i class="fa-solid fa-chevron-right"></i> <strong>@ViewData["Title"]</strong></div><div class="workspace-admin"><span>Company admin</span><b>CA</b></div></header>@RenderBody()<footer class="workspace-footer">&copy; @DateTime.Now.Year ConstructionSaaS <span>Plan. Build. Deliver.</span></footer></div></div>@await RenderSectionAsync("Scripts", required: false)<script src="~/js/workspace-ui.js" asp-append-version="true" defer></script>
</body></html>

