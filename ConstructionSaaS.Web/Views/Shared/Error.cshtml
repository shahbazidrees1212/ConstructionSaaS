@model ErrorViewModel
@{ Layout = "_RecoveryLayout"; ViewData["Title"] = "Something went wrong"; }
<p class="eyebrow">TEMPORARILY UNAVAILABLE</p><h1>We couldn't complete that request.</h1>
<p>Please try again shortly. If the issue continues, share the reference below with your administrator.</p>
@if (Model.ShowRequestId) { <p class="module-muted">Reference: <code>@Model.RequestId</code></p> }
<a class="primary-button" asp-controller="Account" asp-action="Login">Return to sign in</a>
