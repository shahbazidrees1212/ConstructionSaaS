<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] | ConstructionSaaS</title>

    

    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/assignments.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/workspace-polish.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/workspace-refinement.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/clarity-dashboard.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/clarity-people.css" asp-append-version="true" /></head>

<body class="admin-dashboard clarity-dashboard clarity-people">

    <a class="skip-link" href="#assignmentContent">Skip to assignments</a>

    <div class="dashboard"><partial name="_AdminSidebar" />

        <main class="main">

            <header class="topbar"><div class="breadcrumb">Workspace <span>/</span><strong>Project Assignments</strong></div><div class="topbar-right"><a class="topbar-create" asp-controller="TeamMembers" asp-action="Index"><i class="fa-solid fa-users" aria-hidden="true"></i> Manage team</a><a class="account-avatar" asp-controller="Workspace" asp-action="Settings" aria-label="Account settings">CA</a></div></header>

            <div class="content assignment-content" id="assignmentContent">@RenderBody()<footer class="footer"><span>&copy; @DateTime.Now.Year ConstructionSaaS.</span><span>Plan. Build. Deliver.</span></footer></div>

        </main>

    </div>

    <script>document.querySelectorAll('.sidebar .nav-link').forEach(link => { link.setAttribute('aria-label', link.textContent.trim()); link.title = link.textContent.trim(); });</script>

<script src="~/js/workspace-ui.js" asp-append-version="true" defer></script>

</body>

</html>

