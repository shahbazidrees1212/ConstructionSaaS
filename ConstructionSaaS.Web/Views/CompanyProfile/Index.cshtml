@model ConstructionSaaS.Web.Models.CompanyProfileViewModel
@{ Layout = "_AdminWorkspaceLayout"; ViewData["Active"] = "CompanyProfile"; ViewData["Title"] = "Company profile"; }
<section class="module-hero"><div><h1>Company profile</h1><p>Your company, clearly defined.</p></div></section>
@if(ViewBag.ErrorMessage is string error){<p class="clarity-notice" role="alert">@error</p>}
<section class="company-banner"><span class="company-emblem"><i class="fa-regular fa-building" aria-hidden="true"></i></span><div><h2>@Model.Name</h2><span class="module-pill">@(Model.IsActive ? "Active" : "Inactive")</span> <span class="company-reference">Company ID: @Model.Id</span></div></section>
<div class="company-columns"><section class="panel"><h2>Company information</h2><p class="company-description">Update the name shown across your workspace.</p><form asp-controller="CompanyProfile" asp-action="Index" method="post" class="module-form">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden"/><input asp-for="IsActive" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Name">Company name</label><input asp-for="Name" maxlength="200" required autocomplete="organization"/><span asp-validation-for="Name" class="text-danger"></span><dl class="company-facts"><div><dt>Company ID</dt><dd>@Model.Id</dd></div><div><dt>Status</dt><dd>@(Model.IsActive ? "Active" : "Inactive")</dd></div></dl><div class="company-actions"><a class="module-secondary" asp-action="Index">Cancel</a><button class="primary-button" type="submit">Save changes</button></div></form></section><aside><section class="company-identity"><p class="eyebrow">YOUR WORKSPACE</p><h2>One company.<br/>One connected workspace.</h2><i class="fa-solid fa-city" aria-hidden="true"></i></section><section class="panel company-links"><h2>Related settings</h2><a asp-controller="TeamMembers" asp-action="Index"><i class="fa-solid fa-users" aria-hidden="true"></i> Team members <span>&rarr;</span></a><a asp-controller="ProjectAssignments" asp-action="Index"><i class="fa-solid fa-user-check" aria-hidden="true"></i> Project assignments <span>&rarr;</span></a><a asp-controller="Subscription" asp-action="Index"><i class="fa-regular fa-credit-card" aria-hidden="true"></i> Subscription & billing <span>&rarr;</span></a></section></aside></div>
