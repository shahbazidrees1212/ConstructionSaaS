@{
    ViewData["Title"] = "Site Engineer Dashboard";
    Layout = null;

    var companyId = ViewBag.CompanyId;
    var userEmail = ViewBag.UserEmail as string
                    ?? "Site Engineer";

    var displayName = userEmail.Contains("@")
        ? userEmail.Split('@')[0]
        : userEmail;

    var initial = string.IsNullOrWhiteSpace(displayName)
        ? "S"
        : displayName.Substring(0, 1).ToUpperInvariant();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ConstructionSaaS</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --navy: #0b1220;
            --primary: #4f6ef7;
            --background: #f5f7fc;
            --surface: #ffffff;
            --text: #17243b;
            --muted: #8491a6;
            --border: #e9edf5;
            --sidebar-width: 258px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: var(--background);
            color: var(--text);
        }

        .dashboard-layout {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */

        .sidebar {
            width: var(--sidebar-width);
            background: var(--navy);
            color: #fff;
            position: fixed;
            inset: 0 auto 0 0;
            display: flex;
            flex-direction: column;
            padding: 28px 17px 20px;
            z-index: 100;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 12px 34px;
        }

        .brand-icon {
            width: 43px;
            height: 43px;
            background: linear-gradient(135deg, #4f6ef7, #8b5cf6);
            border-radius: 13px;
            display: grid;
            place-items: center;
            font-size: 22px;
        }

        .brand-name {
            font-size: 18px;
            font-weight: 800;
        }

            .brand-name span {
                color: #92a4ff;
            }

        .brand-caption {
            color: #75849e;
            font-size: 10px;
            letter-spacing: 1.5px;
            margin-top: 4px;
        }

        .nav-label {
            font-size: 10px;
            letter-spacing: 1.5px;
            color: #66758d;
            font-weight: 700;
            padding: 0 17px;
            margin: 22px 0 12px;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 13px 16px;
            border-radius: 11px;
            color: #9daac0;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 5px;
            text-decoration: none;
        }

            .sidebar-link i {
                font-size: 18px;
                width: 21px;
                text-align: center;
            }

            .sidebar-link.active {
                background: linear-gradient(100deg, #4968e9, #5c6cf0);
                color: #fff;
            }

            .sidebar-link.disabled-link {
                opacity: .5;
                cursor: not-allowed;
            }

        .sidebar-bottom {
            margin-top: auto;
            border-top: 1px solid #233047;
            padding-top: 20px;
        }

        .sidebar-profile {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 12px 10px;
        }

        .sidebar-avatar {
            width: 37px;
            height: 37px;
            background: #334b86;
            border-radius: 11px;
            display: grid;
            place-items: center;
            font-weight: 800;
        }

        .sidebar-profile-name {
            font-size: 12px;
            font-weight: 700;
            overflow-wrap: anywhere;
        }

        .sidebar-profile-role {
            color: #8795ae;
            font-size: 11px;
            margin-top: 4px;
        }

        /* MAIN */

        .main-content {
            margin-left: var(--sidebar-width);
            width: calc(100% - var(--sidebar-width));
            min-width: 0;
        }

        .topbar {
            height: 82px;
            background: #fff;
            border-bottom: 1px solid var(--border);
            padding: 0 35px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }

        .breadcrumb {
            font-size: 13px;
            color: #8a96a9;
        }

            .breadcrumb strong {
                color: #27364d;
            }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 17px;
        }

        .topbar-date {
            color: #748198;
            font-size: 12px;
        }

        .topbar-avatar {
            height: 38px;
            width: 38px;
            border-radius: 12px;
            background: #edf1ff;
            color: var(--primary);
            display: grid;
            place-items: center;
            font-weight: 800;
        }

        .content-container {
            padding: 34px 35px 40px;
            max-width: 1700px;
            margin: auto;
        }

        .page-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 26px;
        }

            .page-heading h1 {
                font-size: 27px;
                font-weight: 800;
                margin-bottom: 7px;
            }

            .page-heading p {
                color: var(--muted);
                font-size: 13px;
            }

        .role-badge {
            background: #e7f8f2;
            color: #07966c;
            padding: 10px 15px;
            border-radius: 9px;
            font-size: 12px;
            font-weight: 750;
            white-space: nowrap;
        }

        /* WELCOME */

        .welcome-banner {
            background: linear-gradient( 110deg, #124f66, #168e91 65%, #29b6a1);
            border-radius: 19px;
            padding: 32px 35px;
            color: #fff;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 27px;
            min-height: 176px;
            overflow: hidden;
        }

        .welcome-kicker {
            font-size: 11px;
            letter-spacing: 1.5px;
            color: #d4f7f2;
            margin-bottom: 11px;
            font-weight: 700;
        }

        .welcome-banner h2 {
            font-size: 25px;
            margin-bottom: 11px;
        }

        .welcome-banner p {
            font-size: 13px;
            color: #e0f7f4;
            max-width: 520px;
            line-height: 1.8;
        }

        .banner-icon {
            font-size: 80px;
            color: rgba(255,255,255,.25);
            margin-right: 30px;
        }

        /* STATS */

        .section-title {
            margin-bottom: 17px;
        }

            .section-title h3 {
                font-size: 17px;
                font-weight: 800;
            }

            .section-title p {
                color: var(--muted);
                font-size: 12px;
                margin-top: 5px;
            }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 19px;
            margin-bottom: 29px;
        }

        .stat-card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 15px;
            padding: 22px;
            box-shadow: 0 5px 20px rgba(22,35,66,.03);
        }

        .stat-icon {
            width: 45px;
            height: 45px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            font-size: 20px;
            margin-bottom: 20px;
        }

            .stat-icon.blue {
                background: #eef2ff;
                color: #4f6ef7;
            }

            .stat-icon.green {
                background: #e7faf3;
                color: #0eaf80;
            }

            .stat-icon.orange {
                background: #fff5df;
                color: #e69b14;
            }

            .stat-icon.purple {
                background: #f3edff;
                color: #8b5cf6;
            }

        .stat-label {
            color: #78869b;
            font-size: 12px;
            font-weight: 600;
        }

        .stat-value {
            font-size: 31px;
            font-weight: 800;
            margin: 12px 0 8px;
        }

        .stat-footer {
            font-size: 11px;
            color: #9aa6b8;
        }

        /* CONTENT */

        .dashboard-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.8fr) minmax(280px, 1fr);
            gap: 21px;
            margin-bottom: 23px;
        }

        .panel {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 25px;
            box-shadow: 0 5px 20px rgba(22,35,66,.03);
            min-width: 0;
        }

        .panel-header {
            margin-bottom: 23px;
        }

            .panel-header h3 {
                font-size: 16px;
                font-weight: 800;
            }

            .panel-header p {
                font-size: 12px;
                color: var(--muted);
                margin-top: 6px;
            }

        .empty-state {
            border: 1px dashed #d9e1ed;
            border-radius: 13px;
            background: #fafbfe;
            min-height: 245px;
            padding: 35px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        .empty-icon {
            height: 61px;
            width: 61px;
            border-radius: 17px;
            background: #e7f8f2;
            color: #0c9d80;
            display: grid;
            place-items: center;
            font-size: 27px;
            margin-bottom: 17px;
        }

        .empty-state h4 {
            font-size: 15px;
            margin-bottom: 8px;
        }

        .empty-state p {
            font-size: 12px;
            color: var(--muted);
            line-height: 1.8;
            max-width: 330px;
        }

        .quick-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .action-card {
            background: #f8faff;
            border: 1px solid #edf1f8;
            border-radius: 11px;
            padding: 17px 13px;
            opacity: .75;
        }

            .action-card i {
                display: block;
                font-size: 21px;
                color: #168e91;
                margin-bottom: 11px;
            }

            .action-card strong {
                display: block;
                font-size: 12px;
                margin-bottom: 6px;
            }

            .action-card span {
                font-size: 10px;
                color: #97a2b4;
                line-height: 1.6;
            }

        .lower-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.8fr) minmax(280px, 1fr);
            gap: 21px;
        }

        .activity-empty {
            display: flex;
            gap: 15px;
            align-items: center;
            padding: 20px;
            background: #fafbfe;
            border: 1px dashed #d9e1ed;
            border-radius: 11px;
        }

            .activity-empty i {
                font-size: 24px;
                color: #65b6b2;
            }

            .activity-empty strong {
                display: block;
                font-size: 12px;
                margin-bottom: 6px;
            }

            .activity-empty p {
                font-size: 11px;
                color: var(--muted);
                line-height: 1.6;
            }

        .account-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 14px;
            padding: 13px 0;
            border-bottom: 1px solid #eff2f7;
        }

            .account-row:last-child {
                border-bottom: none;
            }

            .account-row .label {
                font-size: 12px;
                color: #8b98ab;
            }

            .account-row .value {
                font-size: 12px;
                font-weight: 750;
                text-align: right;
                overflow-wrap: anywhere;
            }

        .page-footer {
            margin-top: 29px;
            font-size: 11px;
            color: #9aa6b8;
            display: flex;
            justify-content: space-between;
            gap: 10px;
        }

        .mobile-menu-button {
            display: none;
            border: 0;
            background: #edf1ff;
            color: #4f6ef7;
            border-radius: 10px;
            width: 39px;
            height: 39px;
            font-size: 20px;
            cursor: pointer;
        }

        .sidebar-overlay {
            display: none;
        }

        @@media (max-width: 1200px) {
            .stats-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 1000px) {
            .dashboard-grid,
            .lower-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 760px) {
            .sidebar {
                transform: translateX(-100%);
                transition: transform .25s;
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .sidebar-overlay.open {
                display: block;
                position: fixed;
                inset: 0;
                background: rgba(9,16,30,.5);
                z-index: 90;
            }

            .main-content {
                margin-left: 0;
                width: 100%;
            }

            .mobile-menu-button {
                display: grid;
                place-items: center;
            }

            .topbar {
                padding: 0 18px;
                height: 70px;
            }

            .topbar-date {
                display: none;
            }

            .content-container {
                padding: 20px 16px;
            }

            .banner-icon {
                display: none;
            }

            .welcome-banner {
                padding: 26px;
            }
        }

        @@media (max-width: 480px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }

            .page-heading {
                flex-direction: column;
                align-items: flex-start;
            }

            .quick-actions {
                grid-template-columns: 1fr 1fr;
            }

            .panel {
                padding: 19px;
            }

            .page-footer {
                flex-direction: column;
            }
        }
    </style>
<link rel="stylesheet" href="~/css/workspace-polish.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/workspace-refinement.css" asp-append-version="true" />
</head>

<body>

    <div class="dashboard-layout">

        <div class="sidebar-overlay"
             id="sidebarOverlay"
             onclick="closeSidebar()"></div>

        <!-- SIDEBAR -->
        <aside class="sidebar" id="sidebar">

            <div class="brand">
                <div class="brand-icon">
                    <i class="bi bi-buildings-fill"></i>
                </div>

                <div>
                    <div class="brand-name">
                        Construction<span>SaaS</span>
                    </div>
                    <div class="brand-caption">
                        Management Platform
                    </div>
                </div>
            </div>

            <div class="nav-label">MAIN MENU</div>

            <nav aria-label="Main navigation">

                <a class="sidebar-link active"
                   asp-controller="EngineerDashboard"
                   asp-action="Index">
                    <i class="bi bi-grid-1x2-fill"></i>
                    Dashboard
                </a>

                <span class="sidebar-link disabled-link">
                    <i class="bi bi-kanban"></i>
                    My Projects
                </span>

                <span class="sidebar-link disabled-link">
                    <i class="bi bi-check2-square"></i>
                    My Tasks
                </span>

                <span class="sidebar-link disabled-link">
                    <i class="bi bi-clipboard-check"></i>
                    Site Inspections
                </span>

                <span class="sidebar-link disabled-link">
                    <i class="bi bi-file-earmark-text"></i>
                    Daily Reports
                </span>

            </nav>

            <div class="nav-label">WORKSPACE</div>

            <nav aria-label="Workspace navigation">

                <span class="sidebar-link disabled-link">
                    <i class="bi bi-gear"></i>
                    Settings
                </span>

            </nav>

            <div class="sidebar-bottom">

                <div class="sidebar-profile">
                    <div class="sidebar-avatar">
                        @initial
                    </div>

                    <div>
                        <div class="sidebar-profile-name">
                            @displayName
                        </div>

                        <div class="sidebar-profile-role">
                            Site Engineer
                        </div>
                    </div>
                </div>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="sidebar-link"
                            style="width:100%;
                               border:none;
                               background:transparent;
                               cursor:pointer;
                               text-align:left;">
                        <i class="bi bi-box-arrow-right"></i>
                        Sign Out
                    </button>
                </form>

            </div>

        </aside>

        <!-- MAIN -->
        <main class="main-content">

            <header class="topbar">

                <div style="display:flex;
                        align-items:center;
                        gap:15px;">

                    <button class="mobile-menu-button"
                            type="button"
                            aria-label="Open navigation"
                            onclick="toggleSidebar()">
                        <i class="bi bi-list"></i>
                    </button>

                    <div class="breadcrumb">
                        <i class="bi bi-house-door"></i>
                        / <strong>Site Engineer Dashboard</strong>
                    </div>

                </div>

                <div class="topbar-right">

                    <div class="topbar-date">
                        <i class="bi bi-calendar3"></i>
                        @DateTime.Now.ToString("dddd, dd MMM yyyy")
                    </div>

                    <div class="topbar-avatar"
                         title="@userEmail">
                        @initial
                    </div>

                </div>

            </header>

            <div class="content-container">

                <!-- HEADING -->
                <div class="page-heading">

                    <div>
                        <h1>Site Operations Overview</h1>
                        <p>
                            Monitor site activities, tasks
                            and construction progress.
                        </p>
                    </div>

                    <div class="role-badge">
                        <i class="bi bi-shield-check"></i>
                        Site Engineer
                    </div>

                </div>

                <!-- WELCOME -->
                <section class="welcome-banner">

                    <div>
                        <div class="welcome-kicker">
                            SITE OPERATIONS WORKSPACE
                        </div>

                        <h2>
                            Welcome back, @displayName!
                        </h2>

                        <p>
                            Track your assigned site work,
                            inspections, daily reports
                            and construction activities
                            from one workspace.
                        </p>
                    </div>

                    <div class="banner-icon">
                        <i class="bi bi-cone-striped"></i>
                    </div>

                </section>

                <!-- STATISTICS -->
                <div class="section-title">
                    <h3>Site Performance Overview</h3>
                    <p>
                        Your assigned site activities
                        and operational indicators
                    </p>
                </div>

                <section class="stats-grid">

                    <div class="stat-card">
                        <div class="stat-icon blue">
                            <i class="bi bi-list-task"></i>
                        </div>
                        <div class="stat-label">
                            Assigned Tasks
                        </div>
                        <div class="stat-value">—</div>
                        <div class="stat-footer">
                            Task API not connected
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon green">
                            <i class="bi bi-check-circle"></i>
                        </div>
                        <div class="stat-label">
                            Completed Tasks
                        </div>
                        <div class="stat-value">—</div>
                        <div class="stat-footer">
                            Task API not connected
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon orange">
                            <i class="bi bi-clipboard-check"></i>
                        </div>
                        <div class="stat-label">
                            Site Inspections
                        </div>
                        <div class="stat-value">—</div>
                        <div class="stat-footer">
                            Inspection API not connected
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon purple">
                            <i class="bi bi-file-earmark-text"></i>
                        </div>
                        <div class="stat-label">
                            Daily Reports
                        </div>
                        <div class="stat-value">—</div>
                        <div class="stat-footer">
                            Reports API not connected
                        </div>
                    </div>

                </section>

                <!-- MAIN GRID -->
                <div class="dashboard-grid">

                    <section class="panel">

                        <div class="panel-header">
                            <h3>My Assigned Tasks</h3>
                            <p>
                                Site activities and tasks
                                assigned to your account
                            </p>
                        </div>

                        <div class="empty-state">

                            <div class="empty-icon">
                                <i class="bi bi-clipboard2-check"></i>
                            </div>

                            <h4>No Task Data Available</h4>

                            <p>
                                Assigned tasks will appear here
                                once the task assignment API
                                is connected.
                            </p>

                        </div>

                    </section>

                    <section class="panel">

                        <div class="panel-header">
                            <h3>Quick Actions</h3>
                            <p>
                                Common site engineering activities
                            </p>
                        </div>

                        <div class="quick-actions">

                            <div class="action-card">
                                <i class="bi bi-list-check"></i>
                                <strong>My Tasks</strong>
                                <span>Coming soon</span>
                            </div>

                            <div class="action-card">
                                <i class="bi bi-clipboard-check"></i>
                                <strong>Inspections</strong>
                                <span>Coming soon</span>
                            </div>

                            <div class="action-card">
                                <i class="bi bi-journal-text"></i>
                                <strong>Daily Report</strong>
                                <span>Coming soon</span>
                            </div>

                            <div class="action-card">
                                <i class="bi bi-camera"></i>
                                <strong>Site Photos</strong>
                                <span>Coming soon</span>
                            </div>

                        </div>

                    </section>

                </div>

                <!-- LOWER GRID -->
                <div class="lower-grid">

                    <section class="panel">

                        <div class="panel-header">
                            <h3>Recent Site Activity</h3>
                            <p>
                                Latest site updates and reports
                            </p>
                        </div>

                        <div class="activity-empty">

                            <i class="bi bi-clock-history"></i>

                            <div>
                                <strong>
                                    No activity data connected
                                </strong>
                                <p>
                                    Task updates, inspections and
                                    daily reports will appear here
                                    after API integration.
                                </p>
                            </div>

                        </div>

                    </section>

                    <section class="panel">

                        <div class="panel-header">
                            <h3>Account Information</h3>
                            <p>
                                Your current workspace details
                            </p>
                        </div>

                        <div class="account-row">
                            <span class="label">Email</span>
                            <span class="value">@userEmail</span>
                        </div>

                        <div class="account-row">
                            <span class="label">Role</span>
                            <span class="value">SiteEngineer</span>
                        </div>

                        <div class="account-row">
                            <span class="label">Company ID</span>
                            <span class="value">@companyId</span>
                        </div>

                        <div class="account-row">
                            <span class="label">Access Level</span>
                            <span class="value">Site Operations</span>
                        </div>

                    </section>

                </div>

                <footer class="page-footer">
                    <span>
                        © @DateTime.Now.Year ConstructionSaaS.
                        All rights reserved.
                    </span>

                    <span>
                        Site Engineer Workspace
                    </span>
                </footer>

            </div>

        </main>

    </div>

    <script>
        function toggleSidebar() {
            document.getElementById("sidebar")
                .classList.toggle("open");

            document.getElementById("sidebarOverlay")
                .classList.toggle("open");
        }

        function closeSidebar() {
            document.getElementById("sidebar")
                .classList.remove("open");

            document.getElementById("sidebarOverlay")
                .classList.remove("open");
        }
    </script>

<script src="~/js/workspace-ui.js" asp-append-version="true" defer></script>
</body>
</html>
