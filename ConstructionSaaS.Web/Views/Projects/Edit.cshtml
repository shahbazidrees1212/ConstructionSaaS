@model ConstructionSaaS.Web.Models.EditProjectViewModel

@{
    Layout = "_EditLayout";
    ViewData["Active"] = "Projects";
    ViewData["Title"] = "Edit Project";
}

<div class="edit-page">

    <div class="edit-heading">
        <div>
            <p class="eyebrow">PROJECT MANAGEMENT</p><h1>Edit project</h1>
            <p class="text-muted mb-0">
                Update project details and manage project status.
            </p>
        </div>

        <a asp-controller="Projects"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Projects
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <form asp-controller="Projects"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <h5 class="fw-semibold mb-3">
                    Project Information
                </h5>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="ProjectCode"
                               class="form-label">Project code</label>
                        <input asp-for="ProjectCode"
                               class="form-control" />
                        <span asp-validation-for="ProjectCode"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Name"
                               class="form-label">Project name</label>
                        <input asp-for="Name"
                               class="form-control" />
                        <span asp-validation-for="Name"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description"
                               class="form-label"></label>
                        <textarea asp-for="Description"
                                  rows="4"
                                  class="form-control"></textarea>
                        <span asp-validation-for="Description"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status"
                               class="form-label fw-semibold">
                            Project Status
                        </label>

                        <select asp-for="Status"
                                class="form-select">
                            <option value="Planning">Planning</option>
                            <option value="Active">Active</option>
                            <option value="OnHold">On Hold</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <h5 class="fw-semibold mb-3">
                    Project Location
                </h5>

                <div class="row g-3">

                    <div class="col-12">
                        <label asp-for="AddressLine1"
                               class="form-label">Street address</label>
                        <input asp-for="AddressLine1"
                               class="form-control" />
                        <span asp-validation-for="AddressLine1"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="City"
                               class="form-label"></label>
                        <input asp-for="City"
                               class="form-control" />
                        <span asp-validation-for="City"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="StateOrProvince"
                               class="form-label">State / province</label>
                        <input asp-for="StateOrProvince"
                               class="form-control" />
                        <span asp-validation-for="StateOrProvince"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PostalCode"
                               class="form-label">Postal code</label>
                        <input asp-for="PostalCode"
                               class="form-control" />
                        <span asp-validation-for="PostalCode"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Country"
                               class="form-label"></label>
                        <input asp-for="Country"
                               class="form-control" />
                        <span asp-validation-for="Country"
                              class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <h5 class="fw-semibold mb-3">
                    Budget & Timeline
                </h5>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Budget"
                               class="form-label"></label>
                        <input asp-for="Budget"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control" />
                        <span asp-validation-for="Budget"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CurrencyCode"
                               class="form-label">Currency code</label>
                        <input asp-for="CurrencyCode"
                               maxlength="3"
                               class="form-control" />
                        <span asp-validation-for="CurrencyCode"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PlannedStartDateUtc"
                               class="form-label">Planned start date</label>
                        <input asp-for="PlannedStartDateUtc"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="PlannedStartDateUtc"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PlannedEndDateUtc"
                               class="form-label">Planned delivery date</label>
                        <input asp-for="PlannedEndDateUtc"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="PlannedEndDateUtc"
                              class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <div class="form-actions">

                    <a asp-controller="Projects"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">
                        Save Changes
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

