@model ConstructionSaaS.Web.Models.CreateProjectViewModel

@{
    Layout = "_AdminWorkspaceLayout";
    ViewData["Active"] = "Projects";
    ViewData["Title"] = "Create project";
}


@section Styles {
<style>
        .form-container {
            max-width: 950px;
            margin: 30px auto;
            padding: 0 20px;
        }

        .form-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 18px;
            padding: 32px;
            box-shadow: 0 8px 30px rgba(15, 23, 42, .04);
        }

        .form-header {
            margin-bottom: 28px;
        }

            .form-header h1 {
                font-size: 26px;
                font-weight: 800;
                color: #0f172a;
                margin-bottom: 8px;
            }

            .form-header p {
                color: #64748b;
            }

        .form-section {
            margin-bottom: 30px;
        }

            .form-section h3 {
                font-size: 16px;
                color: #0f172a;
                margin-bottom: 18px;
                padding-bottom: 12px;
                border-bottom: 1px solid #e2e8f0;
            }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

            .form-group.full-width {
                grid-column: 1 / -1;
            }

            .form-group label {
                font-size: 13px;
                font-weight: 700;
                color: #334155;
            }

        .form-control {
            width: 100%;
            border: 1px solid #dbe3ef;
            border-radius: 10px;
            padding: 12px 14px;
            font: inherit;
            font-size: 14px;
            color: #0f172a;
            background: #fff;
            outline: none;
        }

            .form-control:focus {
                border-color: #f97316;
                box-shadow: 0 0 0 3px rgba(249,115,22,.12);
            }

        textarea.form-control {
            resize: vertical;
            min-height: 110px;
        }

        .validation-error {
            color: #dc2626;
            font-size: 12px;
        }

        .validation-summary {
            color: #b91c1c;
            background: #fff1f2;
            border-radius: 10px;
            padding: 12px 16px;
            margin-bottom: 20px;
        }

            .validation-summary.validation-summary-valid {
                display: none;
            }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            padding-top: 22px;
            border-top: 1px solid #e2e8f0;
        }

        .cancel-button {
            display: inline-flex;
            align-items: center;
            padding: 12px 20px;
            border: 1px solid #dbe3ef;
            border-radius: 10px;
            text-decoration: none;
            color: #475569;
            font-weight: 700;
        }

        .save-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #f97316;
            color: white;
            border: none;
            border-radius: 10px;
            padding: 12px 22px;
            font: inherit;
            font-weight: 700;
            cursor: pointer;
        }

            .save-button:hover {
                background: #ea580c;
            }

        @@media (max-width: 640px) {
            .form-grid {
                grid-template-columns: 1fr;
            }

            .form-card {
                padding: 20px;
            }

            .form-actions {
                flex-direction: column;
            }
        }
    </style>
}


    <div class="form-container">

        <a asp-controller="Projects"
           asp-action="Index"
           class="cancel-button"
           style="margin-bottom:20px;">
            <i class="fa-solid fa-arrow-left"
               style="margin-right:8px;"></i>
            Back to Projects
        </a>

        <div class="form-card">

            <div class="form-header">
                <h1>
                    <i class="fa-solid fa-folder-plus"
                       style="color:#f97316;"></i>
                    Create New Project
                </h1>

                <p>
                    Enter project details to add a new
                    construction project to your workspace.
                </p>
            </div>

            <form asp-controller="Projects"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary"></div>

                <!-- BASIC DETAILS -->
                <div class="form-section">

                    <h3>Basic Information</h3>

                    <div class="form-grid">

                        <div class="form-group">
                            <label asp-for="ProjectCode"></label>

                            <input asp-for="ProjectCode"
                                   class="form-control"
                                   placeholder="PRJ-001" />

                            <span asp-validation-for="ProjectCode"
                                  class="validation-error"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Name"></label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Project name" />

                            <span asp-validation-for="Name"
                                  class="validation-error"></span>
                        </div>

                        <div class="form-group full-width">
                            <label asp-for="Description"></label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      placeholder="Describe your project..."></textarea>

                            <span asp-validation-for="Description"
                                  class="validation-error"></span>
                        </div>

                    </div>
                </div>

                <!-- LOCATION -->
                <div class="form-section">

                    <h3>Project Location</h3>

                    <div class="form-grid">

                        <div class="form-group full-width">
                            <label asp-for="AddressLine1"></label>

                            <input asp-for="AddressLine1"
                                   class="form-control"
                                   placeholder="Street address" />
                        </div>

                        <div class="form-group">
                            <label asp-for="City"></label>

                            <input asp-for="City"
                                   class="form-control"
                                   placeholder="City" />
                        </div>

                        <div class="form-group">
                            <label asp-for="StateOrProvince"></label>

                            <input asp-for="StateOrProvince"
                                   class="form-control"
                                   placeholder="State / Province" />
                        </div>

                        <div class="form-group">
                            <label asp-for="PostalCode"></label>

                            <input asp-for="PostalCode"
                                   class="form-control"
                                   placeholder="Postal code" />
                        </div>

                        <div class="form-group">
                            <label asp-for="Country"></label>

                            <input asp-for="Country"
                                   class="form-control"
                                   placeholder="Country" />

                            <span asp-validation-for="Country"
                                  class="validation-error"></span>
                        </div>

                    </div>
                </div>

                <!-- BUDGET -->
                <div class="form-section">

                    <h3>Budget & Currency</h3>

                    <div class="form-grid">

                        <div class="form-group">
                            <label asp-for="Budget"></label>

                            <input asp-for="Budget"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control"
                                   placeholder="0.00" />

                            <span asp-validation-for="Budget"
                                  class="validation-error"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="CurrencyCode"></label>

                            <input asp-for="CurrencyCode"
                                   maxlength="3"
                                   class="form-control"
                                   placeholder="PKR" />

                            <span asp-validation-for="CurrencyCode"
                                  class="validation-error"></span>
                        </div>

                    </div>
                </div>

                <!-- DATES -->
                <div class="form-section">

                    <h3>Project Timeline</h3>

                    <div class="form-grid">

                        <div class="form-group">
                            <label asp-for="PlannedStartDateUtc"></label>

                            <input asp-for="PlannedStartDateUtc"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="PlannedStartDateUtc"
                                  class="validation-error"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="PlannedEndDateUtc"></label>

                            <input asp-for="PlannedEndDateUtc"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="PlannedEndDateUtc"
                                  class="validation-error"></span>
                        </div>

                    </div>
                </div>

                <!-- ACTIONS -->
                <div class="form-actions">

                    <a asp-controller="Projects"
                       asp-action="Index"
                       class="cancel-button">
                        Cancel
                    </a>

                    <button type="submit"
                            class="save-button">

                        <i class="fa-solid fa-check"></i>
                        Create Project

                    </button>

                </div>

            </form>

        </div>
    </div>

