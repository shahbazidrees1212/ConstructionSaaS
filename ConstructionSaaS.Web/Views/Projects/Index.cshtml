@model List<ConstructionSaaS.Web.Models.DashboardProjectViewModel>
@{ Layout=null; ViewData["Active"]="Projects"; var failed=ViewBag.ErrorMessage as string; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Projects | ConstructionSaaS</title><link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/workspace-polish.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/clarity-dashboard.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/clarity-projects.css" asp-append-version="true"/></head>
<body class="clarity-dashboard clarity-project-page"><a class="skip-link" href="#workspaceContent">Skip to content</a><div class="dashboard"><partial name="_AdminSidebar"/><main class="main"><header class="clarity-topbar"><div>Workspace <span>/</span> <strong>Projects</strong></div><a asp-controller="Workspace" asp-action="Settings">My account <i class="fa-regular fa-user" aria-hidden="true"></i></a></header><div class="clarity-content" id="workspaceContent">
<div class="clarity-heading"><div><h1>Projects</h1><p>Every build, clearly organized.</p></div><a class="clarity-button" asp-action="Create"><span aria-hidden="true">+</span> New project</a></div>
<partial name="_WorkspaceNotices"/>
@if(failed!=null){<p class="clarity-notice" role="alert">@failed</p>}
@if(ViewBag.ProgressError is string progressError){<p class="clarity-notice" role="status">@progressError</p>}
<nav class="project-status-tabs" aria-label="Filter projects by status">@foreach(var status in new[]{"","Planning","Active","Completed"}){<button type="button" data-status-tab="@status" aria-pressed="@(status==""?"true":"false")">@(status==""?"All projects":status)<span>@(failed!=null?"—":(status==""?Model.Count:Model.Count(p=>p.Status==status)).ToString())</span></button>}</nav>
<div class="project-controls"><label class="clarity-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input id="portfolioSearch" type="search" placeholder="Search projects…" aria-label="Search project name or code"/></label><label class="portfolio-status">Status <select id="portfolioStatus"><option value="">All statuses</option>@foreach(var status in Model.Select(p=>p.Status).Concat(new[]{"Planning","Active","Completed"}).Distinct()){<option value="@status">@status</option>}</select></label><div class="portfolio-view" role="group" aria-label="Project view"><button type="button" data-view="grid" aria-pressed="true"><i class="fa-solid fa-table-cells" aria-hidden="true"></i> Grid</button><button type="button" data-view="list" aria-pressed="false"><i class="fa-solid fa-list" aria-hidden="true"></i> List</button></div></div>
<p id="portfolioCount" class="portfolio-count" aria-live="polite">@Model.Count projects</p>
<div class="portfolio-grid" id="portfolioCards">@foreach(var project in Model){<article class="portfolio-card" data-project="@project.Id" data-search="@project.Name @project.ProjectCode" data-status="@project.Status"><div class="portfolio-image"><span>Construction imagery</span></div><div class="portfolio-body"><div class="portfolio-title"><div><h2>@project.Name</h2><p>@(string.IsNullOrEmpty(project.ProjectCode)?$"#{project.Id}":project.ProjectCode)</p></div><span class="clarity-status">@project.Status</span></div><dl class="portfolio-facts"><div><dt>Progress</dt><dd>@if(project.Progress is int progress){<strong>@progress%</strong><progress value="@progress" max="100" aria-label="Progress for @project.Name">@progress%</progress>}else{<strong>Not tracked</strong>}</dd></div><div><dt><i class="fa-regular fa-calendar" aria-hidden="true"></i> Start</dt><dd>@(project.PlannedStartDateUtc?.ToString("dd MMM yyyy")??"Not scheduled")</dd></div><div><dt><i class="fa-regular fa-calendar" aria-hidden="true"></i> Delivery</dt><dd>@(project.PlannedEndDateUtc?.ToString("dd MMM yyyy")??"Not scheduled")</dd></div></dl><div class="portfolio-actions"><button class="clarity-button project-details-toggle" type="button" aria-expanded="false" aria-controls="project-details-@project.Id"><i class="fa-regular fa-eye" aria-hidden="true"></i> View project</button><a class="portfolio-edit" asp-action="Edit" asp-route-id="@project.Id"><i class="fa-solid fa-pen" aria-hidden="true"></i> Edit</a><details class="portfolio-more"><summary aria-label="More actions for @project.Name">&#8943;</summary><div><a asp-controller="ProjectAssignments" asp-action="Index" asp-route-projectId="@project.Id">Manage team</a><a asp-controller="Workspace" asp-action="Documents" asp-route-projectId="@project.Id">Project documents</a><form asp-action="Delete" asp-route-id="@project.Id" method="post" class="project-delete-form"><button type="submit">Delete project</button></form></div></details></div><div class="portfolio-details" id="project-details-@project.Id" hidden><h3>Project overview</h3><p>@(string.IsNullOrWhiteSpace(project.Description)?"No description added yet.":project.Description)</p><p><strong>Location:</strong> @(string.IsNullOrWhiteSpace(project.City)&&string.IsNullOrWhiteSpace(project.Country)?"Not provided":string.Join(", ",new[]{project.City,project.Country}.Where(s=>!string.IsNullOrWhiteSpace(s))))</p><a asp-controller="Workspace" asp-action="Schedule" asp-route-projectId="@project.Id">Open project schedule &#8594;</a></div></div></article>}</div>
<div class="clarity-panel portfolio-empty" id="portfolioEmpty" hidden="@(Model.Count>0)"><h2>@(failed==null?"No projects to show":"Projects unavailable")</h2><p>@(failed==null?"Create your first project or adjust your search and status filters.":"Try refreshing the page when the connection is restored.")</p><button type="button" id="portfolioReset">Reset filters</button></div>
<section class="clarity-panel portfolio-deadlines"><h2><i class="fa-regular fa-calendar" aria-hidden="true"></i> Portfolio deadlines</h2><div class="clarity-table" tabindex="0" role="region" aria-label="Project deadlines"><table><thead><tr><th scope="col">Project</th><th scope="col">Project ID</th><th scope="col">Status</th><th scope="col">Progress</th><th scope="col">Start date</th><th scope="col">Delivery date</th></tr></thead><tbody>@foreach(var project in Model){<tr data-deadline="@project.Id"><td><a asp-action="Edit" asp-route-id="@project.Id">@project.Name</a></td><td>@(string.IsNullOrEmpty(project.ProjectCode)?$"#{project.Id}":project.ProjectCode)</td><td><span class="clarity-status">@project.Status</span></td><td>@(project.Progress is int progress?$"{progress}%":"Not tracked")</td><td>@(project.PlannedStartDateUtc?.ToString("dd MMM yyyy")??"Not scheduled")</td><td>@(project.PlannedEndDateUtc?.ToString("dd MMM yyyy")??"Not scheduled")</td></tr>}</tbody></table></div></section><footer class="clarity-footer">&copy; @DateTime.UtcNow.Year ConstructionSaaS <span>Plan. Build. Deliver.</span></footer>
</div></main></div><script src="~/js/clarity-projects.js" asp-append-version="true" defer></script><script src="~/js/workspace-ui.js" asp-append-version="true" defer></script></body></html>
