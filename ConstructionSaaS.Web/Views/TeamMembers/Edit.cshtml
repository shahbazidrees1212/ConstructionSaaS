@model ConstructionSaaS.Web.Models.EditTeamMemberViewModel
@{
    Layout = "_EditLayout";
    ViewData["Title"] = "Edit Team Member";
    ViewData["Active"] = "TeamMembers";
}
<div class="edit-page">
    <header class="edit-heading">
        <div><p class="eyebrow">TEAM MANAGEMENT</p><h1>Edit team member</h1><p>Keep your team's contact information and assigned role up to date.</p></div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to team</a>
    </header>
    <div class="member-edit-grid">
        <section class="card">
            <div class="card-body">
                <form asp-controller="TeamMembers" asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    <h5>Member information</h5>
                    <p class="form-intro">Update the details for <strong>@Model.Email</strong>.</p>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Email" class="form-label">Work email</label>
                            <input asp-for="Email" type="email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                            <p class="field-hint">This email address is used to sign in.</p>
                        </div>
                        <div class="col-12">
                            <label asp-for="Role" class="form-label">Assigned role</label>
                            <select asp-for="Role" class="form-select">
                                <option value="ProjectManager">Project Manager</option>
                                <option value="SiteEngineer">Site Engineer</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger"></span>
                            <p class="field-hint">Choose the role that matches this member's responsibilities.</p>
                        </div>
                    </div>
                    <hr />
                    <div class="form-actions">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save changes <i class="fa-solid fa-check" aria-hidden="true"></i></button>
                    </div>
                </form>
            </div>
        </section>
        <aside class="edit-help">
            <span class="edit-help-icon"><i class="fa-solid fa-user-shield" aria-hidden="true"></i></span>
            <h2>A well-organized team</h2>
            <p>Keep contact details accurate so every member can access their workspace.</p>
            <h3>Assign the right role</h3>
            <p>Select Project Manager or Site Engineer to reflect the member's work on your projects.</p>
            <a asp-controller="ProjectAssignments" asp-action="Index">Manage project assignments <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </aside>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
