@model ConstructionSaaS.Web.Models.CreateTeamMemberViewModel

@{
    Layout = null;
    ViewData["Active"] = "TeamMembers";
    ViewData["Title"] = "Add Team Member | ConstructionSaaS";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    

    

    

    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/dashboard.css"
          asp-append-version="true" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'DM Sans', sans-serif;
            background: #f4f7fb;
            color: #10264a;
        }

        .create-main {
            min-width: 0;
        }

        .create-topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 30px;
            background: #fff;
            border-bottom: 1px solid #e8edf5;
        }

        .breadcrumb-custom {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 11px;
            font-size: 13px;
            color: #8190a8;
        }

            .breadcrumb-custom a {
                color: #8190a8;
                text-decoration: none;
            }

                .breadcrumb-custom a:hover {
                    color: #ff9f1c;
                }

            .breadcrumb-custom strong {
                color: #142b50;
            }

        .admin-profile {
            display: flex;
            align-items: center;
            gap: 13px;
        }

            .admin-profile span {
                color: #607493;
                font-size: 13px;
                font-weight: 700;
            }

        .admin-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: #102747;
            color: #fff;
            font-weight: 800;
        }

        .create-content {
            padding: 30px;
            max-width: 1250px;
            margin: 0 auto;
        }

        .page-heading {
            margin-bottom: 25px;
        }

            .page-heading .eyebrow {
                color: #37618f;
                font-size: 11px;
                font-weight: 800;
                letter-spacing: 2px;
                margin-bottom: 12px;
            }

            .page-heading h1 {
                font-family: 'Manrope', sans-serif;
                font-size: clamp(26px, 3vw, 34px);
                font-weight: 800;
                letter-spacing: -1px;
                color: #0b2144;
                margin: 0 0 10px;
            }

            .page-heading p {
                color: #7186a4;
                font-size: 14px;
                margin: 0;
                line-height: 1.7;
            }

        .create-layout {
            display: grid;
            grid-template-columns: minmax(0, 1.65fr) minmax(260px, 1fr);
            gap: 22px;
            align-items: start;
        }

        .form-card,
        .info-card {
            background: #fff;
            border: 1px solid #e5ebf4;
            border-radius: 18px;
            overflow: hidden;
        }

        .card-heading {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 25px 28px;
            border-bottom: 1px solid #edf1f6;
        }

        .card-icon {
            width: 48px;
            height: 48px;
            border-radius: 13px;
            display: grid;
            place-items: center;
            background: #fff0d8;
            color: #f59a12;
            font-size: 19px;
            flex-shrink: 0;
        }

        .card-heading h2 {
            margin: 0 0 5px;
            font-size: 18px;
            font-weight: 800;
            color: #10264a;
        }

        .card-heading p {
            margin: 0;
            font-size: 12px;
            color: #91a0b4;
        }

        .form-body {
            padding: 28px;
        }

        .form-group {
            margin-bottom: 23px;
        }

        .form-label-custom {
            display: block;
            color: #304867;
            font-size: 13px;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .required-mark {
            color: #e55769;
        }

        .input-wrap {
            position: relative;
        }

            .input-wrap > i:first-child {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: #9aaac0;
                font-size: 15px;
                pointer-events: none;
            }

        .form-input {
            width: 100%;
            min-height: 48px;
            border: 1px solid #dfe7f2;
            border-radius: 10px;
            background: #fbfcff;
            color: #173251;
            font-family: inherit;
            font-size: 14px;
            padding: 12px 15px 12px 43px;
            outline: none;
            transition: .2s;
        }

            .form-input:focus {
                background: #fff;
                border-color: #ffac37;
                box-shadow: 0 0 0 3px rgba(255, 159, 28, .12);
            }

        .password-input {
            padding-right: 50px;
        }

        .password-toggle {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            border: 0;
            background: transparent;
            color: #8798b0;
            cursor: pointer;
            width: 35px;
            height: 35px;
            display: grid;
            place-items: center;
        }

            .password-toggle:hover {
                color: #10264a;
            }

        .field-hint {
            margin-top: 8px;
            font-size: 12px;
            color: #93a1b5;
            line-height: 1.6;
        }

        .validation-message {
            display: block;
            margin-top: 7px;
            font-size: 12px;
            color: #dc3545;
        }

        .validation-summary {
            color: #b42342;
            background: #fff0f3;
            border: 1px solid #ffd3dc;
            border-radius: 10px;
            padding: 12px 16px;
            margin-bottom: 20px;
            font-size: 13px;
        }

            .validation-summary.validation-summary-valid {
                display: none;
            }

        .form-divider {
            border: 0;
            border-top: 1px solid #edf1f6;
            margin: 27px 0;
        }

        .form-actions {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .submit-btn {
            border: none;
            background: #ff9f1c;
            color: #0b2144;
            border-radius: 10px;
            min-height: 46px;
            padding: 12px 22px;
            font-family: inherit;
            font-size: 13px;
            font-weight: 800;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: .2s;
        }

            .submit-btn:hover {
                background: #f3920c;
                transform: translateY(-1px);
            }

        .cancel-btn {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            min-height: 46px;
            padding: 12px 20px;
            background: #fff;
            color: #62758f;
            border: 1px solid #dfe7f2;
            border-radius: 10px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 700;
        }

            .cancel-btn:hover {
                background: #f6f8fc;
                color: #10264a;
            }

        .info-card {
            padding: 25px;
        }

            .info-card h3 {
                font-size: 15px;
                color: #10264a;
                margin: 0 0 20px;
                font-weight: 800;
            }

        .info-item {
            display: flex;
            gap: 12px;
            margin-bottom: 22px;
        }

            .info-item:last-child {
                margin-bottom: 0;
            }

        .info-symbol {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: grid;
            place-items: center;
            flex-shrink: 0;
            background: #eaf1ff;
            color: #3775d5;
        }

        .info-item strong {
            display: block;
            font-size: 12px;
            color: #253e60;
            margin-bottom: 5px;
        }

        .info-item p {
            margin: 0;
            font-size: 12px;
            line-height: 1.7;
            color: #8a9ab0;
        }

        .create-footer {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 26px;
            color: #99a8ba;
            font-size: 12px;
        }

        @@media (max-width: 1050px) {
            .create-layout {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 700px) {
            .create-content {
                padding: 17px;
            }

            .create-topbar {
                padding: 16px;
            }

            .admin-profile span {
                display: none;
            }

            .card-heading,
            .form-body {
                padding: 20px;
            }

            .page-heading h1 {
                font-size: 27px;
            }
        }
    </style>
<link rel="stylesheet" href="~/css/workspace-polish.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/workspace-refinement.css" asp-append-version="true" />
</head>

<body>
    <div class="dashboard">

        <!-- SIDEBAR -->
        <partial name="_AdminSidebar" />

        <!-- MAIN CONTENT -->
        <main class="main create-main">

            <!-- TOPBAR -->
            <header class="create-topbar">

                <div class="breadcrumb-custom">
                    <a asp-controller="Dashboard"
                       asp-action="Index">
                        Workspace
                    </a>

                    <span>/</span>

                    <a asp-controller="TeamMembers"
                       asp-action="Index">
                        Team Members
                    </a>

                    <span>/</span>
                    <strong>Add Member</strong>
                </div>

                <div class="admin-profile">
                    <span>Company Admin</span>
                    <div class="admin-avatar">CS</div>
                </div>

            </header>

            <div class="create-content">

                <!-- PAGE HEADER -->
                <section class="page-heading">
                    <p class="eyebrow">TEAM MANAGEMENT</p>
                    <h1>Add a new team member.</h1>
                    <p>
                        Create a secure account and assign the appropriate
                        role to your new team member.
                    </p>
                </section>

                <div class="create-layout">

                    <!-- CREATE FORM -->
                    <section class="form-card">

                        <div class="card-heading">
                            <div class="card-icon">
                                <i class="fa-solid fa-user-plus"></i>
                            </div>

                            <div>
                                <h2>Member Information</h2>
                                <p>Enter the details to create a new account.</p>
                            </div>
                        </div>

                        <form asp-controller="TeamMembers"
                              asp-action="Create"
                              method="post">

                            @Html.AntiForgeryToken()

                            <div class="form-body">

                                <div asp-validation-summary="ModelOnly"
                                     class="validation-summary"></div>

                                <!-- EMAIL -->
                                <div class="form-group">
                                    <label asp-for="Email"
                                           class="form-label-custom">
                                        Work Email
                                        <span class="required-mark">*</span>
                                    </label>

                                    <div class="input-wrap">
                                        <i class="fa-regular fa-envelope"></i>

                                        <input asp-for="Email"
                                               type="email"
                                               class="form-input"
                                               placeholder="member@company.com"
                                               autocomplete="email" />
                                    </div>

                                    <span asp-validation-for="Email"
                                          class="validation-message"></span>
                                </div>

                                <!-- PASSWORD -->
                                <div class="form-group">
                                    <label asp-for="Password"
                                           class="form-label-custom">
                                        Temporary Password
                                        <span class="required-mark">*</span>
                                    </label>

                                    <div class="input-wrap">
                                        <i class="fa-solid fa-lock"></i>

                                        <input asp-for="Password"
                                               type="password"
                                               id="memberPassword"
                                               class="form-input password-input"
                                               placeholder="Enter a secure password"
                                               autocomplete="new-password" />

                                        <button type="button"
                                                class="password-toggle"
                                                id="togglePassword"
                                                aria-label="Show password"
                                                aria-pressed="false">
                                            <i class="fa-regular fa-eye"></i>
                                        </button>
                                    </div>

                                    <span asp-validation-for="Password"
                                          class="validation-message"></span>

                                    <div class="field-hint">
                                        Use at least 8 characters.
                                        A mix of uppercase, lowercase,
                                        numbers and symbols is recommended.
                                    </div>
                                </div>

                                <!-- ROLE -->
                                <div class="form-group">
                                    <label asp-for="Role"
                                           class="form-label-custom">
                                        Assign Role
                                        <span class="required-mark">*</span>
                                    </label>

                                    <div class="input-wrap">
                                        <i class="fa-solid fa-user-shield"></i>

                                        <select asp-for="Role"
                                                class="form-input">
                                            <option value="ProjectManager">
                                                Project Manager
                                            </option>

                                            <option value="SiteEngineer">
                                                Site Engineer
                                            </option>
                                        </select>
                                    </div>

                                    <span asp-validation-for="Role"
                                          class="validation-message"></span>
                                </div>

                                <hr class="form-divider" />

                                <!-- BUTTONS -->
                                <div class="form-actions">

                                    <button type="submit"
                                            class="submit-btn">
                                        <i class="fa-solid fa-user-plus"></i>
                                        Create Team Member
                                    </button>

                                    <a asp-controller="TeamMembers"
                                       asp-action="Index"
                                       class="cancel-btn">
                                        <i class="fa-solid fa-arrow-left"></i>
                                        Cancel
                                    </a>

                                </div>

                            </div>
                        </form>

                    </section>

                    <!-- SIDE INFORMATION -->
                    <aside class="info-card">

                        <h3>
                            <i class="fa-solid fa-circle-info"
                               style="color:#2876e8;margin-right:8px;"></i>
                            Role Information
                        </h3>

                        <div class="info-item">
                            <div class="info-symbol">
                                <i class="fa-solid fa-helmet-safety"></i>
                            </div>

                            <div>
                                <strong>Project Manager</strong>
                                <p>
                                    Intended for coordinating project work
                                    and managing assigned responsibilities.
                                    Actual access depends on API permissions.
                                </p>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-symbol">
                                <i class="fa-solid fa-hard-hat"></i>
                            </div>

                            <div>
                                <strong>Site Engineer</strong>
                                <p>
                                    Intended for site-related tasks
                                    and engineering updates.
                                    Actual access depends on API permissions.
                                </p>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-symbol">
                                <i class="fa-solid fa-shield-halved"></i>
                            </div>

                            <div>
                                <strong>Account Security</strong>
                                <p>
                                    Share initial credentials securely.
                                    Do not reuse passwords across accounts.
                                </p>
                            </div>
                        </div>

                    </aside>

                </div>

                <footer class="create-footer">
                    <span>
                        © @DateTime.Now.Year ConstructionSaaS.
                        All rights reserved.
                    </span>

                    <span>Plan. Build. Deliver.</span>
                </footer>

            </div>
        </main>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const passwordInput =
                document.getElementById("memberPassword");

            const toggleButton =
                document.getElementById("togglePassword");

            if (!passwordInput || !toggleButton)
                return;

            toggleButton.addEventListener("click", function () {

                const isHidden = passwordInput.type === "password";

                passwordInput.type = isHidden ? "text" : "password";

                toggleButton.setAttribute(
                    "aria-pressed",
                    isHidden ? "true" : "false"
                );

                toggleButton.setAttribute(
                    "aria-label",
                    isHidden ? "Hide password" : "Show password"
                );

                const icon = toggleButton.querySelector("i");

                if (icon) {
                    icon.className = isHidden
                        ? "fa-regular fa-eye-slash"
                        : "fa-regular fa-eye";
                }
            });
        });
    </script>

<script src="~/js/workspace-ui.js" asp-append-version="true" defer></script>
</body>
</html>
