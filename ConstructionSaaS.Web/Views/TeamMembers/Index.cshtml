@model List<ConstructionSaaS.Web.Models.TeamMemberViewModel>



@{

    Layout = null;

    ViewData["Active"] = "TeamMembers";

    ViewData["Title"] = "Team Members | ConstructionSaaS";



    var members = Model ?? new List<ConstructionSaaS.Web.Models.TeamMemberViewModel>();

    var totalCount = members.Count;

    var activeCount = members.Count(x => x.IsActive);

    var inactiveCount = totalCount - activeCount;

    var managerCount = members.Count(x => x.Role == "ProjectManager");

    var engineerCount = members.Count(x => x.Role == "SiteEngineer");

}



<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />



    <title>@ViewData["Title"]</title>



    

    



    



    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />



    <link rel="stylesheet"

          href="~/css/dashboard.css"

          asp-append-version="true" />



    <style>

        * {

            box-sizing: border-box;

        }



        body {

            margin: 0;

            font-family: 'DM Sans', sans-serif;

            background: #f4f7fb;

            color: #10264a;

        }



        .team-page {

            min-height: 100vh;

        }



        .team-main {

            min-width: 0;

        }



        .team-content {

            padding: 28px;

            max-width: 1600px;

            margin: 0 auto;

        }



        .team-breadcrumb {

            display: flex;

            align-items: center;

            gap: 12px;

            color: #8190a8;

            font-size: 13px;

        }



            .team-breadcrumb strong {

                color: #142b50;

            }



        .team-topbar {

            display: flex;

            justify-content: space-between;

            align-items: center;

            gap: 16px;

            padding: 20px 28px;

            background: #fff;

            border-bottom: 1px solid #e8edf5;

        }



        .topbar-actions {

            display: flex;

            align-items: center;

            gap: 14px;

        }



        .topbar-label {

            font-size: 13px;

            color: #64748b;

            font-weight: 600;

        }



        .team-avatar {

            width: 42px;

            height: 42px;

            border-radius: 50%;

            display: grid;

            place-items: center;

            background: #102747;

            color: white;

            font-weight: 800;

        }



        .team-hero {

            background: linear-gradient(115deg, #edf4ff, #e8f0ff);

            border: 1px solid #e1eafd;

            border-radius: 20px;

            padding: 32px 36px;

            display: flex;

            justify-content: space-between;

            align-items: center;

            gap: 20px;

            margin-bottom: 24px;

        }



        .eyebrow {

            color: #28558c;

            font-size: 11px;

            font-weight: 800;

            letter-spacing: 2px;

            text-transform: uppercase;

            margin: 0 0 12px;

        }



        .team-hero h1 {

            font-family: 'Manrope', sans-serif;

            font-size: clamp(25px, 3vw, 34px);

            font-weight: 800;

            letter-spacing: -1px;

            margin: 0 0 10px;

            color: #0b2144;

        }



        .team-hero p {

            margin: 0;

            color: #58739a;

            font-size: 14px;

            line-height: 1.7;

        }



        .primary-action {

            display: inline-flex;

            justify-content: center;

            align-items: center;

            gap: 10px;

            background: #ff9f1c;

            color: #0b2144;

            text-decoration: none;

            border-radius: 11px;

            padding: 14px 20px;

            font-weight: 800;

            font-size: 13px;

            white-space: nowrap;

            box-shadow: 0 5px 14px rgba(255, 159, 28, .16);

            transition: .2s;

        }



            .primary-action:hover {

                background: #f3920c;

                transform: translateY(-1px);

                color: #0b2144;

            }



        .team-stats {

            display: grid;

            grid-template-columns: repeat(4, minmax(0, 1fr));

            gap: 16px;

            margin-bottom: 24px;

        }



        .team-stat {

            background: white;

            border: 1px solid #e8edf5;

            border-radius: 17px;

            padding: 22px;

            display: flex;

            align-items: center;

            gap: 16px;

            min-width: 0;

        }



        .stat-symbol {

            width: 52px;

            height: 52px;

            border-radius: 14px;

            display: grid;

            place-items: center;

            flex-shrink: 0;

            font-size: 20px;

        }



        .stat-purple {

            color: #7849e9;

            background: #eee7ff;

        }



        .stat-green {

            color: #0d9b67;

            background: #def8eb;

        }



        .stat-red {

            color: #dc5570;

            background: #ffebef;

        }



        .stat-blue {

            color: #2876e8;

            background: #e5efff;

        }



        .team-stat-label {

            font-size: 12px;

            color: #607493;

            font-weight: 600;

            margin-bottom: 7px;

        }



        .team-stat-value {

            font-size: 28px;

            font-family: 'Manrope', sans-serif;

            font-weight: 800;

            color: #10264a;

            line-height: 1.1;

        }



        .team-panel {

            background: #fff;

            border: 1px solid #e7edf5;

            border-radius: 18px;

            overflow: hidden;

        }



        .panel-heading {

            display: flex;

            justify-content: space-between;

            align-items: center;

            gap: 18px;

            padding: 24px 26px;

            border-bottom: 1px solid #edf1f6;

        }



            .panel-heading h2 {

                margin: 0 0 6px;

                font-size: 18px;

                font-weight: 800;

                color: #10264a;

            }



            .panel-heading p {

                margin: 0;

                font-size: 13px;

                color: #8392aa;

            }



            .panel-heading h2 i {

                color: #2876e8;

                margin-right: 8px;

            }



        .member-count {

            font-size: 12px;

            color: #567091;

            font-weight: 700;

            background: #f1f5fa;

            padding: 9px 13px;

            border-radius: 9px;

        }



        .filter-bar {

            display: flex;

            align-items: center;

            flex-wrap: wrap;

            gap: 12px;

            padding: 18px 26px;

            border-bottom: 1px solid #edf1f6;

        }



        .search-field {

            display: flex;

            align-items: center;

            gap: 10px;

            border: 1px solid #e2e9f3;

            background: #f8fafd;

            border-radius: 10px;

            padding: 0 14px;

            min-height: 43px;

            flex: 1;

            min-width: 200px;

        }



            .search-field i {

                color: #95a4ba;

            }



            .search-field input {

                border: 0;

                outline: 0;

                background: transparent;

                width: 100%;

                color: #10264a;

                font: inherit;

                font-size: 13px;

            }



        .filter-select {

            border: 1px solid #e2e9f3;

            background: #fff;

            border-radius: 10px;

            padding: 11px 13px;

            color: #425875;

            font: inherit;

            font-size: 13px;

            min-height: 43px;

        }



        .table-wrap {

            overflow-x: auto;

        }



        .members-table {

            width: 100%;

            border-collapse: collapse;

            text-align: left;

        }



            .members-table thead {

                background: #f6f9fc;

            }



            .members-table th {

                padding: 17px 24px;

                color: #536987;

                font-size: 11px;

                letter-spacing: .45px;

                text-transform: uppercase;

                font-weight: 800;

                white-space: nowrap;

            }



            .members-table td {

                padding: 19px 24px;

                border-top: 1px solid #edf1f6;

                color: #405675;

                font-size: 13px;

                vertical-align: middle;

            }



            .members-table tbody tr:hover {

                background: #fbfcff;

            }



        .member-info {

            display: flex;

            align-items: center;

            gap: 12px;

        }



        .member-icon {

            width: 40px;

            height: 40px;

            border-radius: 12px;

            display: grid;

            place-items: center;

            background: #e9efff;

            color: #5374ce;

            flex-shrink: 0;

        }



        .member-email {

            color: #142b50;

            font-weight: 700;

            overflow-wrap: anywhere;

        }



        .member-subtitle {

            color: #98a6b9;

            font-size: 11px;

            margin-top: 4px;

        }



        .role-badge {

            display: inline-flex;

            align-items: center;

            padding: 7px 11px;

            border-radius: 8px;

            font-size: 11px;

            font-weight: 800;

            white-space: nowrap;

        }



        .role-manager {

            color: #2863c7;

            background: #e8f0ff;

        }



        .role-engineer {

            color: #7750b8;

            background: #f0eaff;

        }



        .status-pill {

            display: inline-flex;

            align-items: center;

            gap: 7px;

            padding: 7px 11px;

            border-radius: 30px;

            font-size: 11px;

            font-weight: 800;

        }



            .status-pill::before {

                content: "";

                width: 7px;

                height: 7px;

                border-radius: 50%;

                background: currentColor;

            }



        .status-active {

            background: #e4f8ee;

            color: #109765;

        }



        .status-inactive {

            background: #f0f2f5;

            color: #8b98a9;

        }



        .member-actions {

            display: flex;

            align-items: center;

            gap: 8px;

        }



        .action-edit,

        .action-deactivate {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            gap: 7px;

            border-radius: 8px;

            padding: 9px 12px;

            font: inherit;

            font-size: 12px;

            font-weight: 700;

            cursor: pointer;

            text-decoration: none;

            white-space: nowrap;

        }



        .action-edit {

            color: #286bd5;

            background: #edf4ff;

            border: 1px solid #dceaff;

        }



            .action-edit:hover {

                background: #dfeeff;

            }



        .action-deactivate {

            color: #d34c63;

            background: #fff2f4;

            border: 1px solid #ffe0e5;

        }



            .action-deactivate:hover {

                background: #ffe3e8;

            }



        .inactive-note {

            color: #9aa7b8;

            font-size: 12px;

        }



        .empty-members {

            text-align: center;

            padding: 58px 20px;

        }



            .empty-members i {

                font-size: 34px;

                color: #9aabc3;

                margin-bottom: 16px;

            }



            .empty-members h3 {

                color: #1c3558;

                font-size: 17px;

                margin: 0 0 8px;

            }



            .empty-members p {

                color: #92a0b4;

                font-size: 13px;

            }



        .team-alert {

            padding: 15px 18px;

            border-radius: 11px;

            margin-bottom: 20px;

            font-size: 13px;

            font-weight: 600;

        }



        .alert-success {

            color: #087c53;

            background: #e5f8ee;

            border: 1px solid #c6ecd9;

        }



        .alert-danger {

            color: #b42342;

            background: #fff0f3;

            border: 1px solid #ffd3dc;

        }



        .team-footer {

            display: flex;

            justify-content: space-between;

            gap: 12px;

            padding: 22px 2px;

            color: #97a5b7;

            font-size: 12px;

        }



        .sidebar .nav-link {

            text-decoration: none;

        }



        .members-table tr[hidden] {

            display: none !important;

        }



        @@media (max-width: 1100px) {

            .team-stats {

                grid-template-columns: repeat(2, minmax(0, 1fr));

            }

        }



        @@media (max-width: 700px) {

            .team-content {

                padding: 16px;

            }



            .team-topbar {

                padding: 16px;

            }



            .team-hero {

                padding: 24px;

                flex-direction: column;

                align-items: flex-start;

            }



            .team-stats {

                grid-template-columns: 1fr;

            }



            .panel-heading {

                padding: 20px;

            }



            .filter-bar {

                padding: 16px;

            }



            .team-footer {

                flex-direction: column;

            }

        }

    </style>

<link rel="stylesheet" href="~/css/workspace-polish.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/workspace-refinement.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/clarity-dashboard.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/clarity-people.css" asp-append-version="true" /></head>



<body class="clarity-dashboard clarity-people">

    <div class="dashboard team-page">



        <!-- SIDEBAR -->

        <partial name="_AdminSidebar" />



        <!-- MAIN -->

        <main class="main team-main">



            <header class="team-topbar">

                <div class="team-breadcrumb">

                    <span>Workspace</span>

                    <span>/</span>

                    <strong>Team Members</strong>

                </div>



                <div class="topbar-actions">

                    <span class="topbar-label">Company Admin</span>

                    <div class="team-avatar">CS</div>

                </div>

            </header>



            <div class="team-content">



                @if (TempData["SuccessMessage"] != null)

                {

                    <div class="team-alert alert-success" role="alert">

                        <i class="fa-solid fa-circle-check"></i>

                        @TempData["SuccessMessage"]

                    </div>

                }



                @if (TempData["ErrorMessage"] != null)

                {

                    <div class="team-alert alert-danger" role="alert">

                        <i class="fa-solid fa-circle-exclamation"></i>

                        @TempData["ErrorMessage"]

                    </div>

                }



                @if (ViewBag.ErrorMessage != null)

                {

                    <div class="team-alert alert-danger" role="alert">

                        <i class="fa-solid fa-circle-exclamation"></i>

                        @ViewBag.ErrorMessage

                    </div>

                }



                <!-- HERO -->

                <section class="team-hero">

                    <div>

                        <p class="eyebrow">TEAM MANAGEMENT</p>

                        <h1>People behind every build.</h1>

                        <p>

                            Organize your project managers and site engineers

                            in one secure workspace.

                        </p>

                    </div>



                    <a asp-controller="TeamMembers"

                       asp-action="Create"

                       class="primary-action">

                        <i class="fa-solid fa-plus"></i>

                        Add Team Member

                    </a>

                </section>



                <!-- STATISTICS -->

                <section class="team-stats" aria-label="Team statistics">



                    <article class="team-stat">

                        <div class="stat-symbol stat-purple">

                            <i class="fa-solid fa-users"></i>

                        </div>

                        <div>

                            <div class="team-stat-label">Total Members</div>

                            <div class="team-stat-value">@totalCount</div>

                        </div>

                    </article>



                    <article class="team-stat">

                        <div class="stat-symbol stat-green">

                            <i class="fa-solid fa-user-check"></i>

                        </div>

                        <div>

                            <div class="team-stat-label">Active Members</div>

                            <div class="team-stat-value">@activeCount</div>

                        </div>

                    </article>



                    <article class="team-stat">

                        <div class="stat-symbol stat-red">

                            <i class="fa-solid fa-user-slash"></i>

                        </div>

                        <div>

                            <div class="team-stat-label">Inactive Members</div>

                            <div class="team-stat-value">@inactiveCount</div>

                        </div>

                    </article>



                    <article class="team-stat">

                        <div class="stat-symbol stat-blue">

                            <i class="fa-solid fa-helmet-safety"></i>

                        </div>

                        <div>

                            <div class="team-stat-label">Project Managers</div>

                            <div class="team-stat-value">@managerCount</div>

                        </div>

                    </article>



                </section>



                <!-- MEMBER LIST -->

                <section class="team-panel">



                    <div class="panel-heading">

                        <div>

                            <h2>

                                <i class="fa-solid fa-address-book"></i>

                                Company Team

                            </h2>

                            <p>

                                View roles, account status and manage access.

                            </p>

                        </div>



                        <span class="member-count">

                            @totalCount members

                        </span>

                    </div>



                    <!-- SEARCH AND FILTER -->

                    <div class="filter-bar">



                        <label class="search-field">

                            <i class="fa-solid fa-magnifying-glass"></i>

                            <input type="search"

                                   id="memberSearch"

                                   placeholder="Search by email..."

                                   aria-label="Search team members" />

                        </label>



                        <select id="roleFilter"

                                class="filter-select"

                                aria-label="Filter by role">

                            <option value="all">All Roles</option>

                            <option value="ProjectManager">Project Manager</option>

                            <option value="SiteEngineer">Site Engineer</option>

                        </select>



                        <select id="statusFilter"

                                class="filter-select"

                                aria-label="Filter by status">

                            <option value="all">All Statuses</option>

                            <option value="active">Active</option>

                            <option value="inactive">Inactive</option>

                        </select>



                    </div>



                    <div class="table-wrap">

                        <table class="members-table">

                            <thead>

                                <tr>

                                    <th>Team Member</th>

                                    <th>Role</th>

                                    <th>Status</th>

                                    <th>Actions</th>

                                </tr>

                            </thead>



                            <tbody id="membersBody">



                                @if (!members.Any())

                                {

                                    <tr>

                                        <td colspan="4">

                                            <div class="empty-members">

                                                <i class="fa-solid fa-users"></i>

                                                <h3>No team members found</h3>

                                                <p>

                                                    Start building your team by adding

                                                    your first member.

                                                </p>

                                            </div>

                                        </td>

                                    </tr>

                                }

                                else

                                {

                                    @foreach (var member in members)

                                    {

                                        var roleName =

                                        member.Role == "ProjectManager"

                                        ? "Project Manager"

                                        : member.Role == "SiteEngineer"

                                        ? "Site Engineer"

                                        : member.Role;



                                        <tr class="member-row"

                                            data-email="@member.Email.ToLowerInvariant()"

                                            data-role="@member.Role"

                                            data-status="@(member.IsActive ? "active" : "inactive")">



                                            <td>

                                                <div class="member-info">

                                                    <div class="member-icon">

                                                        <i class="fa-solid fa-user"></i>

                                                    </div>



                                                    <div>

                                                        <div class="member-email">

                                                            @member.Email

                                                        </div>

                                                        <div class="member-subtitle">

                                                            Company team member

                                                        </div>

                                                    </div>

                                                </div>

                                            </td>



                                            <td>

                                                <span class="role-badge @(member.Role == "ProjectManager" ? "role-manager" : "role-engineer")">

                                                    @roleName

                                                </span>

                                            </td>



                                            <td>

                                                @if (member.IsActive)

                                                {

                                                    <span class="status-pill status-active">

                                                        Active

                                                    </span>

                                                }

                                                else

                                                {

                                                    <span class="status-pill status-inactive">

                                                        Inactive

                                                    </span>

                                                }

                                            </td>



                                            <td>

                                                @if (member.IsActive)

                                                {

                                                    <div class="member-actions">

                                                        <a asp-controller="TeamMembers"

                                                           asp-action="Edit"

                                                           asp-route-id="@member.Id"

                                                           class="action-edit">

                                                            <i class="fa-solid fa-pen"></i>

                                                            Edit

                                                        </a>



                                                        <form asp-controller="TeamMembers"

                                                              asp-action="Deactivate"

                                                              asp-route-id="@member.Id"

                                                              method="post"

                                                              onsubmit="return confirm('Are you sure you want to deactivate this team member?');">



                                                            @Html.AntiForgeryToken()



                                                            <button type="submit"

                                                                    class="action-deactivate">

                                                                <i class="fa-solid fa-user-slash"></i>

                                                                Deactivate

                                                            </button>

                                                        </form>

                                                    </div>

                                                }

                                                else

                                                {

                                                    <form asp-action="Activate" asp-route-id="@member.Id" method="post">@Html.AntiForgeryToken()<button type="submit" class="action-edit">Activate member</button></form>

                                                }

                                            </td>



                                        </tr>

                                    }



                                    <tr id="filterEmptyRow" hidden>

                                        <td colspan="4">

                                            <div class="empty-members">

                                                <i class="fa-solid fa-magnifying-glass"></i>

                                                <h3>No matching members</h3>

                                                <p>Try adjusting your search or filters.</p>

                                            </div>

                                        </td>

                                    </tr>

                                }



                            </tbody>

                        </table>

                    </div>



                </section>



                <section class="people-access"><h2>Access at a glance</h2><div><article><h3>Project managers</h3><p>Coordinate delivery and team tasks across their assigned projects.</p></article><article><h3>Site engineers</h3><p>Track assigned work and share progress from the field.</p></article></div><a asp-controller="ProjectAssignments" asp-action="Index">Manage project assignments &rarr;</a></section><footer class="team-footer">

                    <span>

                        © @DateTime.Now.Year ConstructionSaaS.

                        All rights reserved.

                    </span>

                    <span>Plan. Build. Deliver.</span>

                </footer>



            </div>

        </main>

    </div>



    <script>

        document.addEventListener("DOMContentLoaded", function () {



            const search = document.getElementById("memberSearch");

            const roleFilter = document.getElementById("roleFilter");

            const statusFilter = document.getElementById("statusFilter");



            const rows = document.querySelectorAll(".member-row");

            const emptyRow = document.getElementById("filterEmptyRow");



            function applyFilters() {

                const query = (search?.value || "").toLowerCase().trim();

                const role = roleFilter?.value || "all";

                const status = statusFilter?.value || "all";



                let visibleCount = 0;



                rows.forEach(function (row) {

                    const email = row.dataset.email || "";

                    const memberRole = row.dataset.role || "";

                    const memberStatus = row.dataset.status || "";



                    const matchesSearch = email.includes(query);

                    const matchesRole =

                        role === "all" || memberRole === role;

                    const matchesStatus =

                        status === "all" || memberStatus === status;



                    const visible =

                        matchesSearch && matchesRole && matchesStatus;



                    row.hidden = !visible;



                    if (visible) visibleCount++;

                });



                if (emptyRow) {

                    emptyRow.hidden =

                        rows.length === 0 || visibleCount > 0;

                }

            }



            search?.addEventListener("input", applyFilters);

            roleFilter?.addEventListener("change", applyFilters);

            statusFilter?.addEventListener("change", applyFilters);

        });

    </script>

<script src="~/js/workspace-ui.js" asp-append-version="true" defer></script>

</body>

</html>



